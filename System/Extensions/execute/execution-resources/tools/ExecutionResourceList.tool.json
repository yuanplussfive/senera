{
  "name": "ExecutionResourceList",
  "loading": "Bootstrap",
  "presentation": {
    "category": "execution-list",
    "icon": "stack",
    "activity": {
      "action": {
        "zh-CN": "列出",
        "en-US": "List"
      }
    },
    "preview": {
      "body": {
        "pointer": "/resources",
        "from": "result"
      }
    }
  },
  "description": "列出当前会话拥有的后台终端和进程资源。",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": {
      "not": {}
    },
    "definitions": {}
  },
  "permissions": ["process:shell"],
  "execution": {
    "Targets": ["Local"],
    "Network": "Deny",
    "Workspace": "ReadOnly"
  },
  "runtime": {
    "Lifecycle": "Immediate",
    "ProtocolVersion": 2,
    "ResultAssessment": "ProcessExit",
    "Scheduling": "SelfManaged"
  },
  "resources": [],
  "sources": [
    {
      "Id": "execution",
      "Title": "Execution",
      "Description": "Shell commands, processes, terminals, builds, tests, and other executable workloads."
    }
  ],
  "search": {
    "Summary": "列出当前会话拥有的后台终端和进程资源。",
    "Capabilities": [
      {
        "Id": "execution.resource-list",
        "Title": "List execution resources",
        "Description": "列出当前会话拥有的后台终端、进程和可恢复执行资源。",
        "Facets": {
          "Actions": ["list", "inspect"],
          "Targets": ["execution-resource", "terminal", "process"],
          "Outputs": ["resource-list", "process-state"]
        },
        "Aliases": ["列出后台终端", "列出正在运行的后台终端", "列出后台进程", "列出执行资源"]
      }
    ],
    "UseCases": ["需要确认当前会话有哪些后台命令、终端或进程仍在运行时。"],
    "Tags": ["后台终端", "资源列表", "会话控制"]
  },
  "evidenceCapabilities": [],
  "artifacts": {
    "Summary": {
      "Template": "{{ toolName }} returned {{ result.resources | size }} execution resources",
      "ArtifactTemplate": "{% for resource in result.resources %}- resourceId: {{ resource.resourceId }}\n  kind: {{ resource.kind }}\n  state: {{ resource.state }}\n  command: {{ resource.command }}\n  cwd: {{ resource.cwd }}\n  cursor: {{ resource.cursor }}\n{% endfor %}"
    }
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "resources": {
        "type": "array",
        "items": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "resourceId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": ["process", "terminal"]
            },
            "state": {
              "type": "string"
            },
            "fromCursor": {
              "type": "number"
            },
            "cursor": {
              "type": "number"
            },
            "oldestCursor": {
              "type": "number"
            },
            "historyTruncated": {
              "type": "boolean"
            },
            "updates": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "exitCode": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "signal": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "error": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            }
          },
          "required": [
            "resourceId",
            "kind",
            "state",
            "fromCursor",
            "cursor",
            "oldestCursor",
            "updates",
            "command",
            "cwd"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": ["resources"],
    "additionalProperties": false
  }
}
