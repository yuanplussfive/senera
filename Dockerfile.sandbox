# syntax=docker/dockerfile:1.7

ARG SENERA_SANDBOX_SOURCE_IMAGE
FROM ${SENERA_SANDBOX_SOURCE_IMAGE}

ARG SENERA_SANDBOX_DISTRIBUTION_ID
ARG SENERA_SANDBOX_DISTRIBUTION_VERSION
ARG SENERA_SANDBOX_TARGET
ARG SENERA_SANDBOX_SOURCE_IMAGE

LABEL ai.senera.sandbox.distribution-id="${SENERA_SANDBOX_DISTRIBUTION_ID}" \
  ai.senera.sandbox.distribution-version="${SENERA_SANDBOX_DISTRIBUTION_VERSION}" \
  ai.senera.sandbox.target="${SENERA_SANDBOX_TARGET}" \
  ai.senera.sandbox.source-image="${SENERA_SANDBOX_SOURCE_IMAGE}"
