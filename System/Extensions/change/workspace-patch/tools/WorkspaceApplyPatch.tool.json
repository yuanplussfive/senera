{
  "name": "WorkspaceApplyPatch",
  "loading": "Bootstrap",
  "presentation": {
    "category": "workspace-patch",
    "icon": "pencil",
    "activity": {
      "action": { "zh-CN": "应用补丁", "en-US": "Apply patch" },
      "detailPaths": ["/operations/*/path", "/operations/*/source", "/operations/*/destination"]
    }
  },
  "observationProjection": "observations/default.projection.json",
  "description": "以 add、update、write、delete、move 操作原子修改工作区文件；Skill/MCP 候选通过完整预检后才提交。",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "operations": {
        "minItems": 1,
        "maxItems": 64,
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "add" },
                "path": { "type": "string", "minLength": 1 },
                "content": { "type": "string" }
              },
              "required": ["kind", "path", "content"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "update" },
                "path": { "type": "string", "minLength": 1 },
                "oldStr": { "type": "string", "minLength": 1 },
                "newStr": { "type": "string" }
              },
              "required": ["kind", "path", "oldStr", "newStr"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "write" },
                "path": { "type": "string", "minLength": 1 },
                "content": { "type": "string" }
              },
              "required": ["kind", "path", "content"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "delete" },
                "path": { "type": "string", "minLength": 1 }
              },
              "required": ["kind", "path"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "move" },
                "source": { "type": "string", "minLength": 1 },
                "destination": { "type": "string", "minLength": 1 }
              },
              "required": ["kind", "source", "destination"],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "required": ["operations"],
    "additionalProperties": false
  },
  "permissions": ["filesystem:read:workspace", "filesystem:write:workspace"],
  "execution": { "Targets": ["Local"], "Network": "Deny", "Workspace": "ReadWrite" },
  "runtime": {
    "Lifecycle": "Immediate",
    "ProtocolVersion": 2,
    "ResultAssessment": "ProcessExit",
    "Scheduling": "ResourceClaims",
    "MaxConcurrency": 1,
    "Capabilities": { "Progress": true, "Cancellation": true }
  },
  "resources": [
    {
      "Capability": "senera.workspace.path",
      "Pointer": "/operations",
      "Parameters": { "Intent": "replace", "PathPointers": ["/*/path", "/*/source", "/*/destination"] }
    }
  ],
  "sources": [
    {
      "Id": "workspace",
      "Title": "Workspace",
      "Description": "Files, directories, and source code in the current workspace."
    }
  ],
  "search": {
    "Summary": "以原子方式应用高层工作区补丁（add/update/write/delete/move），并在提交前完整验证受影响的 Skill/MCP 候选。",
    "Tags": ["文件编辑", "代码修改", "apply_patch", "补丁", "工作区写入", "新增文件", "删除文件", "移动文件"],
    "Capabilities": [
      {
        "Id": "workspace.apply-patch",
        "Title": "Workspace apply patch",
        "Description": "Apply high-level workspace patch operations (add/update/write/delete/move) with precise content or oldStr/newStr replacement.",
        "Facets": {
          "Actions": ["patch", "edit", "add", "write", "update", "delete", "move"],
          "Targets": ["workspace", "file", "directory", "source-code", "configuration", "documentation"],
          "Inputs": ["operations", "content", "oldStr", "newStr"],
          "Outputs": ["workspace-patch-result", "workspace-file-change", "workspace-diff"],
          "Evidence": ["workspace-patch-result", "workspace-diff"],
          "Effects": ["write-workspace"]
        },
        "Aliases": [
          "edit",
          "write",
          "apply patch",
          "应用补丁",
          "修改代码",
          "新增文件",
          "删除文件",
          "移动文件",
          "替换文本"
        ],
        "Risk": {
          "SideEffect": "write-workspace",
          "Permission": "write",
          "Notes": [
            "Changes workspace files via atomic patch operations.",
            "Destructive delete operations require the normal workspace write approval path."
          ]
        }
      }
    ],
    "UseCases": [
      "需要以 add/update/write/delete/move 直接表达代码修改时使用。",
      "需要新增文件、删除文件、移动文件时使用。",
      "需要一次创建或修改完整的 .senera/skills 或 .senera/mcp 包时使用。",
      "已读取目标文件内容，能给出准确 content 或 oldStr/newStr 精确替换时使用。"
    ],
    "Examples": ["新增一个 TypeScript 文件", "用 oldStr/newStr 精确替换已有函数", "移动文件并同时修正导出名"],
    "Avoid": [
      "只读查询不要使用。",
      "不知道已有文件内容时先用 WorkspaceRead、WorkspaceGrep 或 WorkspaceFind 获取证据，再生成补丁。",
      "不要把 unified hunk 或 oldText 格式传给本工具，update 使用 oldStr/newStr 精确替换。",
      "不要传 dryRun/fuzzFactor/expectedSha256，本工具不再接受这些字段。"
    ]
  },
  "evidenceCapabilities": [],
  "approval": { "Mode": "ask", "Reason": "应用工作区文件补丁。" },
  "artifacts": {
    "Evidence": [
      {
        "Kind": "workspace_patch_result",
        "Records": "$",
        "Slots": { "text": "$.text", "applied": "$.applied", "operationCount": "$.operationCount" },
        "Identity": { "Parts": ["text", "operationCount"] },
        "Presentation": {
          "Locator": "workspace-patch",
          "Display": "Workspace patch",
          "Label": "Workspace patch",
          "Source": "{{ text }}"
        },
        "Confidence": 0.92,
        "Metadata": { "applied": "$.applied", "operationCount": "$.operationCount" },
        "ModelProjection": { "Slots": ["text", "applied", "operationCount"] },
        "PlannerMemory": {
          "Facts": ["text", "applied", "operationCount"],
          "ArtifactRefs": ["evidence", "projection", "workspaceDiff", "workspacePatch"]
        },
        "Projection": {
          "SummaryTemplate": "{% for e in evidence %}- evidenceUri: {{ e.evidenceUri }} workspace patch: {{ e.slots.text }}\n{% endfor %}",
          "ArtifactTemplate": "{% for e in evidence %}- evidenceUri: {{ e.evidenceUri }} workspace patch\n  text: {{ e.slots.text }}\n  applied: {{ e.slots.applied }}\n  operationCount: {{ e.slots.operationCount }}\n{% endfor %}"
        }
      }
    ],
    "Summary": {
      "Template": "{% for block in projections %}{{ block.summary }}\n{% endfor %}",
      "ArtifactTemplate": "{% for block in projections %}{{ block.artifact }}\n{% endfor %}{% if workspace %}{% for change in workspace.changes %}- {{ change.status }} {{ change.path }}\n{% endfor %}{% endif %}"
    },
    "Workspace": {
      "Capture": "declared",
      "Paths": [
        { "Selector": "$.operations[*].path" },
        { "Selector": "$.operations[*].source" },
        { "Selector": "$.operations[*].destination" },
        { "Selector": "$.changedPaths[*]" }
      ],
      "MaxFileBytes": 262144,
      "MaxFiles": 64,
      "MaxDirectoryDepth": 1,
      "CaptureContent": "text",
      "PatchContextLines": 3
    }
  }
}
