{
  "defaultSuite": "core",
  "suites": {
    "workspace": {
      "description": "Root workspace dependency and install-boundary governance.",
      "patterns": [
        "VerifyWorkspaceDependencyGovernance.js",
        "VerifyCommitMessagePolicy.js",
        "VerifyNanoDistribution.js"
      ]
    },
    "contracts": {
      "description": "Static architecture contracts that should fail before runtime tests.",
      "patterns": ["VerifyAgentTypeContractBoundaries.js"]
    },
    "core": {
      "description": "Agent runtime and extension contracts without browser, E2E, or OS-specific checks.",
      "patterns": [
        "VerifyAgentTypeContractBoundaries.js",
        "VerifyBackendTestCoverage.js",
        "VerifyRuntimeEventContract.js",
        "VerifyWebSocketProtocolReference.js",
        "VerifyToolExecutionPolicy.js",
        "VerifyWorkspaceApplyPatchTool.js",
        "VerifyToolSignatureMappingAndPlanValidation.js",
        "VerifyModelProviderEndpointConfig.js",
        "VerifyProviderModelDomainCommands.js",
        "VerifyPiModelRequestProjection.js",
        "VerifyModelTimeoutConfig.js",
        "VerifyAgentRuntimeServices.js",
        "VerifyMemorySourceIdempotency.js",
        "VerifyPiResourceProjection.js",
        "VerifyPiNativeWorkflowResourceRouting.js",
        "VerifyPiTurnLease.js",
        "VerifyPiSessionLazyLifecycle.js",
        "VerifyPiCodingAgentSessionReuse.js",
        "VerifyPiRuntimeQueueSteering.js",
        "VerifyAgentLoopRuntimeBoundary.js",
        "VerifyPiTurnExecutorContracts.js",
        "VerifyPiPlanningCompiler.js",
        "VerifyPiToolExecutionBridge.js",
        "VerifyComplexityBudget.js",
        "VerifyConfigServiceSqliteSource.js",
        "VerifyConfigServiceJsonMigration.js"
      ]
    },
    "frontend": {
      "description": "Frontend test and Ladle governance; behavior tests run through the test commands.",
      "patterns": ["VerifyFrontendTestCoverage.js", "VerifyFrontendLadleContracts.js"]
    },
    "integration": {
      "description": "Cross-component protocol, frontend bridge, and runtime integration governance.",
      "patterns": ["VerifyIntegrationTestCoverage.js"]
    },
    "e2e": {
      "description": "Real-browser end-to-end architecture and journey governance.",
      "patterns": ["VerifyBrowserE2eContracts.js"]
    },
    "platform": {
      "description": "Cross-platform execution, sandbox, and desktop path smoke checks.",
      "patterns": [
        "VerifySeneraExecutionEnvBoundary.js",
        "VerifySeneraSandboxRuntimeService.js",
        "VerifySandboxRuntimeConfig.js",
        "VerifySandboxPrepareRuntime.js",
        "VerifyDesktopRuntimeConfigProjection.js",
        "VerifyDesktopDockerSandbox.js",
        "VerifyDesktopRuntimePaths.js",
        "VerifyDesktopFrontendSource.js",
        "VerifyDesktopLiveFrontendServer.js",
        "VerifyDesktopLiveLifecycle.js",
        "VerifyDesktopServerBundle.js",
        "VerifyDesktopStartupSurface.js"
      ]
    },
    "release": {
      "description": "Container and desktop release metadata and runtime policies.",
      "patterns": [
        "VerifyDockerNativeSqlite.js",
        "VerifyDockerRuntimeSandboxPolicy.js",
        "VerifySandboxDistributionContract.js",
        "VerifyProductReleaseInfo.js"
      ]
    },
    "all-local": {
      "description": "All standalone contract suites; excludes test runners and probes requiring a live deployment.",
      "includes": ["workspace", "core", "frontend", "integration", "e2e", "platform", "release", "documentation"]
    },
    "documentation": {
      "description": "Documentation links, command references, and runtime version governance.",
      "patterns": ["VerifyDocumentation.js"]
    }
  }
}
