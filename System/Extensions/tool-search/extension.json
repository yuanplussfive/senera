{
  "$schema": "https://schemas.senera.ai/extension/v1.json",
  "schemaVersion": 1,
  "id": "tool-search",
  "version": "2.0.0",
  "displayName": {
    "zh-CN": "工具检索",
    "en-US": "Tool Search"
  },
  "description": {
    "zh-CN": "检索并说明已注册工具，并按当前模型协议调用或加载工具。",
    "en-US": "Searches and describes registered tools, then invokes or loads them through the active model protocol."
  },
  "priority": 10,
  "contributions": [
    {
      "kind": "hostTool",
      "contract": "tools/ToolSearch.tool.json",
      "capability": "tool.search",
      "recommendedForSkills": []
    },
    {
      "kind": "hostTool",
      "contract": "tools/ToolDescribe.tool.json",
      "capability": "tool.describe",
      "recommendedForSkills": []
    },
    {
      "kind": "hostTool",
      "contract": "tools/ToolLoad.tool.json",
      "capability": "tool.load",
      "recommendedForSkills": []
    },
    {
      "kind": "hostTool",
      "contract": "tools/ToolUnload.tool.json",
      "capability": "tool.unload",
      "recommendedForSkills": []
    }
  ]
}
