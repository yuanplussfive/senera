{
  "version": 1,
  "batchSummaryMaxActions": 3,
  "default": {
    "active": "workflow.toolActivity.system.active",
    "completed": "workflow.toolActivity.system.completed",
    "failed": "workflow.toolActivity.system.failed",
    "batchLabels": {
      "active": "workflow.toolBatch.system.active",
      "completed": "workflow.toolBatch.system.completed"
    }
  },
  "origins": {
    "mcp": {
      "active": "workflow.toolActivity.mcp.active",
      "completed": "workflow.toolActivity.mcp.completed",
      "failed": "workflow.toolActivity.mcp.failed",
      "batchLabels": {
        "active": "workflow.toolBatch.mcp.active",
        "completed": "workflow.toolBatch.mcp.completed"
      }
