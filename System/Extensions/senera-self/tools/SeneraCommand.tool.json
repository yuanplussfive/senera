      "ok": { "type": "boolean" },
      "text": { "type": "string" },
      "data": {},
      "error": { "type": "string", "minLength": 1 },
      "approvalRequired": {
        "type": "object",
        "properties": {
          "approvalId": { "type": "string", "minLength": 1 },
