{
  "name": "TerminalStartTool",
  "observationProjection": "observations/resource.projection.json",
  "description": "启动需要交互输入、终端尺寸和 PTY 语义的持久终端。",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "command": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "const": "shell" },
          "dialect": { "type": "string", "enum": ["posix-sh", "powershell"] },
          "script": { "type": "string" }
        },
        "required": ["mode", "dialect", "script"],
        "additionalProperties": false
      },
      "cwd": { "type": "string" },
      "justification": { "type": "string" },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "用于终端标签的简短任务标题，不要重复完整命令。"
      },
      "columns": { "type": "number" },
      "rows": { "type": "number" }
    },
    "required": ["command"],
    "additionalProperties": false,
    "definitions": {}
  },
  "permissions": ["process:shell", "filesystem:workspace"],
  "execution": {
    "Targets": ["Sandbox", "Local"],
    "Network": "Allow",
    "Workspace": "ReadWrite"
  },
  "runtime": {
    "Lifecycle": "Persistent",
    "ProtocolVersion": 2,
    "ResultAssessment": "ProcessExit",
    "Scheduling": "SelfManaged",
    "Capabilities": {
      "OutputStreaming": true,
      "InteractiveInput": true,
      "Cancellation": true,
      "ResumableEvents": true
    }
  },
  "resources": [{ "Capability": "senera.workspace.path", "Pointer": "/cwd", "Parameters": { "Intent": "execute" } }],
  "sources": [
    {
      "Id": "execution",
      "Title": "Execution",
      "Description": "Shell commands, processes, terminals, builds, tests, and other executable workloads."
    }
  ],
  "search": {
    "Summary": "启动需要 PTY 交互的持久终端。",
    "Capabilities": [
      {
        "Id": "execution.terminal-start",
        "Description": "Start an interactive PTY-backed terminal.",
        "Facets": {
          "Actions": ["start", "interact", "monitor"],
          "Targets": ["terminal", "pty", "interactive-process"],
          "Inputs": ["command", "cwd", "columns", "rows"],
          "Outputs": ["resource-id", "process-state", "cursor"],
          "Effects": ["process", "may-write-workspace", "network-possible"]
        }
      }
    ],
    "UseCases": ["需要交互式 CLI、终端输入或实时 PTY 输出时使用。"],
    "Avoid": ["普通后台服务、构建和测试优先使用会自动转为可恢复资源的 ShellCommandTool。"],
    "Tags": ["PTY", "终端", "交互进程"]
  },
  "evidenceCapabilities": [],
  "artifacts": {
    "Summary": {
      "Template": "{{ toolName }} resource {{ result.resourceId }}: {{ result.state }}",
      "ArtifactTemplate": "- resourceId: {{ result.resourceId }}\n  state: {{ result.state }}\n  cursor: {{ result.cursor }}{% if result.exitCode != blank %}\n  exitCode: {{ result.exitCode }}{% endif %}{% if result.signal %}\n  signal: {{ result.signal }}{% endif %}{% if result.truncated %}\n  outputHistoryTruncated: true{% endif %}{% for event in result.events %}{% if event.kind == 'output' %}\n\n[{{ event.stream }} cursor={{ event.cursor }}]\n{{ event.text }}{% elsif event.kind == 'state' %}\n\n[state cursor={{ event.cursor }}] {{ event.state }}{% if event.reason %}: {{ event.reason }}{% endif %}{% endif %}{% endfor %}"
    }
  }
}
