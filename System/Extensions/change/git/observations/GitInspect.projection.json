{
  "$schema": "https://schemas.senera.ai/tool-observation-projection/v2.json",
  "schemaVersion": 2,
  "maxTokens": 8192,
  "maxOmissions": 32,
  "artifactFallback": { "strategy": "reference", "requiredWhenTruncated": true },
  "sources": [
    {
      "source": "headline",
      "mode": "text",
      "priority": "essential",
      "requiredForCompletion": true,
      "maxTokens": 128,
      "limits": { "maxDepth": 1, "maxArrayItems": 4, "maxObjectProperties": 8, "maxNodes": 16 }
    },
    {
      "source": "summary",
      "mode": "text",
      "priority": "high",
      "requiredForCompletion": true,
      "maxTokens": 256,
      "limits": { "maxDepth": 1, "maxArrayItems": 4, "maxObjectProperties": 8, "maxNodes": 16 }
    },
    {
      "source": "semanticDigest",
      "mode": "text",
      "priority": "high",
      "requiredForCompletion": false,
      "maxTokens": 2048,
      "limits": { "maxDepth": 1, "maxArrayItems": 4, "maxObjectProperties": 8, "maxNodes": 16 }
    },
    {
      "source": "retrieval",
      "mode": "json",
      "priority": "high",
      "requiredForCompletion": true,
      "maxTokens": 128,
      "limits": { "maxDepth": 4, "maxArrayItems": 16, "maxObjectProperties": 16, "maxNodes": 96 }
    },
    {
      "source": "result",
      "mode": "json",
      "priority": "normal",
      "requiredForCompletion": true,
      "maxTokens": 1024,
      "limits": { "maxDepth": 4, "maxArrayItems": 16, "maxObjectProperties": 16, "maxNodes": 96 }
    },
    {
      "source": "limitations",
      "mode": "orderedArray",
      "priority": "low",
      "requiredForCompletion": false,
      "maxTokens": 128,
      "limits": { "maxDepth": 4, "maxArrayItems": 16, "maxObjectProperties": 16, "maxNodes": 96 }
    }
  ]
}
