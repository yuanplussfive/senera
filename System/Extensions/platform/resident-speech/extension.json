{
  "$schema": "https://schemas.senera.ai/extension/v1.json",
  "schemaVersion": 1,
  "id": "resident-speech",
  "domain": "platform",
  "settingsSurface": "system-tools",
  "presentation": {
    "category": "resident-speech",
    "icon": "message-question",
    "group": {
      "id": "resident-speech",
      "title": { "zh-CN": "角色表达", "en-US": "Resident expression" }
    },
    "activity": {
      "action": { "zh-CN": "生成角色发言", "en-US": "Project resident speech" }
    }
  },
  "version": "1.0.0",
  "displayName": {
    "zh-CN": "角色发言投影",
    "en-US": "Resident Speech Projection"
