{
  "form": {
    "version": 1,
    "sections": [
      {
        "id": "model-pool",
        "label": {
          "zh-CN": "模型池",
          "en-US": "Model pool"
        },
        "fields": [
          {
            "path": ["modelPool", "inheritParent"],
            "label": {
              "zh-CN": "继承发起模型",
              "en-US": "Inherit delegating model"
            },
            "description": {
              "zh-CN": "优先使用发起委派所用的模型。",
              "en-US": "Prefer the model used by the delegating run."
            },
            "type": "boolean",
            "defaultValue": true,
            "required": false,
            "essential": true
          },
          {
            "path": ["modelPool", "includeConfiguredModels"],
            "label": {
              "zh-CN": "允许选择已配置模型",
              "en-US": "Allow configured models"
            },
            "description": {
              "zh-CN": "允许 AI 按任务选择所有已启用且满足代理运行要求的模型。关闭时仅允许继承模型与候选列表。已有模型池配置保持原有范围。",
              "en-US": "Let the AI choose any enabled model that meets agent runtime requirements. When disabled, only the inherited model and listed candidates are allowed. Existing pool configurations retain their scope."
            },
            "type": "boolean",
            "defaultValue": false,
            "required": false,
            "essential": true
          },
          {
            "path": ["modelPool", "modelProviderIds"],
            "label": {
              "zh-CN": "候选模型",
              "en-US": "Candidate models"
            },
            "description": {
              "zh-CN": "显式候选模型，顺序决定未指定模型时的选择优先级；关闭自动发现时，这也是允许范围。",
              "en-US": "Explicit candidates in default selection order. With configured-model discovery disabled, these also define the allowed pool."
            },
            "placeholder": {
              "zh-CN": "添加候选模型",
              "en-US": "Add a candidate model"
            },
            "type": "array",
            "itemType": "string",
            "required": false,
            "essential": true,
            "modelSelection": {
              "id": "agent-delegation-model-pool",
              "capability": "Chat",
              "valueKind": "model-id",
              "mutation": "config",
              "cardinality": "many",
              "inheritance": {
                "source": "parent-model",
                "path": ["modelPool", "inheritParent"]
              },
              "required": false
            }
          }
        ]
      },
      {
        "id": "defaults",
        "label": {
          "zh-CN": "子代理默认能力",
          "en-US": "Child agent defaults"
        },
        "description": {
          "zh-CN": "固定 Skill 会在每个子任务开始前由 Senera 校验并激活；thinking 未固定时继承父运行。",
          "en-US": "Pinned Skills are validated and activated by Senera before each child task; thinking inherits from the parent when not pinned."
        },
        "fields": [
          {
            "path": ["defaults", "skills"],
            "label": {
              "zh-CN": "固定启用的 Skill",
              "en-US": "Pinned Skills"
            },
            "description": {
              "zh-CN": "这些 Skill 会与子任务自动匹配的 Skill 合并并去重。",
              "en-US": "These Skills are merged with automatically selected child-task Skills and deduplicated."
            },
            "type": "array",
            "itemType": "string",
            "required": false,
            "essential": true,
            "optionSource": {
              "catalog": "skills"
            }
          },
          {
            "path": ["defaults", "thinkingLevel"],
            "label": {
              "zh-CN": "默认 thinking",
              "en-US": "Default thinking"
            },
            "description": {
              "zh-CN": "未指定时优先使用角色声明，其次继承父运行的 thinking。",
              "en-US": "When unset, prefer the role declaration, then inherit the parent run's thinking level."
            },
            "type": "string",
            "defaultValue": "inherit",
            "options": ["inherit", "off", "minimal", "low", "medium", "high", "xhigh", "max"],
            "optionLabels": {
              "inherit": {
                "zh-CN": "继承父运行",
                "en-US": "Inherit parent"
              },
              "off": {
                "zh-CN": "关闭",
                "en-US": "Off"
              },
              "minimal": {
                "zh-CN": "最小",
                "en-US": "Minimal"
              },
              "low": {
                "zh-CN": "低",
                "en-US": "Low"
              },
              "medium": {
                "zh-CN": "中",
                "en-US": "Medium"
              },
              "high": {
                "zh-CN": "高",
                "en-US": "High"
              },
              "xhigh": {
                "zh-CN": "极高",
                "en-US": "Extra high"
              },
              "max": {
                "zh-CN": "最高",
                "en-US": "Maximum"
              }
            },
            "required": false,
            "essential": true
          }
        ]
      },
      {
        "id": "coordination",
        "label": {
          "zh-CN": "生命周期协调",
          "en-US": "Lifecycle coordination"
        },
        "description": {
          "zh-CN": "宿主内部等待只观察状态；等待超时不会终止子代理。",
          "en-US": "Internal host waits only observe lifecycle changes. A wait timeout never terminates a child run."
        },
        "fields": [
          {
            "path": ["coordination", "defaultWaitTimeoutMs"],
            "label": {
              "zh-CN": "默认等待时长",
              "en-US": "Default wait timeout"
            },
            "type": "number",
            "defaultValue": 30000,
            "min": 0,
            "max": 3600000,
            "step": 1000,
            "required": false,
            "essential": false,
            "durationUnit": "milliseconds"
          },
          {
            "path": ["coordination", "maximumWaitTimeoutMs"],
            "label": {
              "zh-CN": "最大等待时长",
              "en-US": "Maximum wait timeout"
            },
            "type": "number",
            "defaultValue": 3600000,
            "min": 1000,
            "max": 86400000,
            "step": 1000,
            "required": false,
            "essential": false,
            "durationUnit": "milliseconds"
          }
        ]
      },
      {
        "id": "concurrency",
        "label": {
          "zh-CN": "并发控制",
          "en-US": "Concurrency"
        },
        "description": {
          "zh-CN": "默认不设置编排级数量上限；需要资源治理时可显式填写管理员配额。",
          "en-US": "No orchestration-level count limit is applied by default. Administrators may set explicit quotas for resource governance."
        },
        "fields": [
          {
            "path": ["concurrency", "maxRuns"],
            "label": {
              "zh-CN": "最大并发运行",
              "en-US": "Maximum concurrent runs"
            },
            "description": {
              "zh-CN": "留空表示不限；实际吞吐仍受模型供应商和工具资源调度约束。",
              "en-US": "Leave empty for unlimited. Provider and Tool resource backpressure still governs actual throughput."
            },
            "type": "number",
            "min": 1,
            "step": 1,
            "required": false,
            "essential": true
          },
          {
            "path": ["concurrency", "maxWorkspaceWriters"],
            "label": {
              "zh-CN": "最大并发写入",
              "en-US": "Maximum concurrent writers"
            },
            "description": {
              "zh-CN": "留空表示不额外串行化可写子代理；文件与工具声明的资源冲突仍会被调度器阻塞。",
              "en-US": "Leave empty to avoid globally serializing writers. Declared file and Tool resource conflicts are still scheduled."
            },
            "type": "number",
            "min": 1,
            "step": 1,
            "required": false,
            "essential": true
          }
        ]
      },
      {
        "id": "execution",
        "label": {
          "zh-CN": "运行边界",
          "en-US": "Execution limits"
        },
        "description": {
          "zh-CN": "软期限到达后，近期仍有模型或工具生命周期活动的子代理可在上限内续期；随后停止新调查并整理已有证据。",
          "en-US": "At the soft deadline, a child agent with recent typed model or Tool lifecycle activity may receive bounded extensions before it stops new investigation and consolidates existing evidence."
        },
        "fields": [
          {
            "path": ["execution", "deadline", "softTimeoutMs"],
            "label": {
              "zh-CN": "软期限",
              "en-US": "Soft deadline"
            },
            "description": {
              "zh-CN": "默认 15 分钟；排队时间不计入期限。",
              "en-US": "Defaults to 15 minutes. Queue time does not count toward this deadline."
            },
            "type": "number",
            "defaultValue": 900000,
            "min": 60000,
            "max": 86400000,
            "step": 60000,
            "required": false,
            "essential": true,
            "durationUnit": "milliseconds"
          },
          {
            "path": ["execution", "deadline", "activityExtension", "maximumMs"],
            "label": {
              "zh-CN": "最大活动续期",
              "en-US": "Maximum activity extension"
            },
            "description": {
              "zh-CN": "仅近期存在正式模型或工具生命周期活动时续期；默认最多 2 分钟。",
              "en-US": "Granted only when recent typed model or Tool lifecycle events prove progress. Defaults to a maximum of 2 minutes."
            },
            "type": "number",
            "defaultValue": 120000,
            "min": 0,
            "max": 1800000,
            "step": 60000,
            "required": false,
            "essential": true,
            "durationUnit": "milliseconds"
          },
          {
            "path": ["execution", "deadline", "wrapUpTimeoutMs"],
            "label": {
              "zh-CN": "证据整理窗口",
              "en-US": "Evidence wrap-up window"
            },
            "description": {
              "zh-CN": "进入整理后禁止启动新工具或继续委派，默认最多 3 分钟。",
              "en-US": "Once wrap-up starts, no new Tools or delegation may begin. Defaults to at most 3 minutes."
            },
            "type": "number",
            "defaultValue": 180000,
            "min": 10000,
            "max": 1800000,
            "step": 10000,
            "required": false,
            "essential": true,
            "durationUnit": "milliseconds"
          },
          {
            "path": ["execution", "deadline", "activityExtension", "stepMs"],
            "label": {
              "zh-CN": "单次续期",
              "en-US": "Extension step"
            },
            "type": "number",
            "defaultValue": 60000,
            "min": 1000,
            "max": 300000,
            "step": 1000,
            "required": false,
            "essential": false,
            "durationUnit": "milliseconds"
          },
          {
            "path": ["execution", "deadline", "activityExtension", "recentActivityWindowMs"],
            "label": {
              "zh-CN": "实时输出判定窗口",
              "en-US": "Live-output window"
            },
            "type": "number",
            "defaultValue": 30000,
            "min": 1000,
            "max": 300000,
            "step": 1000,
            "required": false,
            "essential": false,
            "durationUnit": "milliseconds"
          },
          {
            "path": ["execution", "deadline", "snapshotIntervalMs"],
            "label": {
              "zh-CN": "活动快照间隔",
              "en-US": "Activity snapshot interval"
            },
            "type": "number",
            "defaultValue": 5000,
            "min": 500,
            "max": 60000,
            "step": 500,
            "required": false,
            "essential": false,
            "durationUnit": "milliseconds"
          },
          {
            "path": ["execution", "maxDepth"],
            "label": {
              "zh-CN": "最大嵌套层级",
              "en-US": "Maximum nesting depth"
            },
            "description": {
              "zh-CN": "默认允许一层子代理；显式清空可放开层级，仍受能力继承和资源所有权约束。",
              "en-US": "One child level by default. Explicit null permits deeper trees subject to inherited capabilities and resource ownership."
            },
            "type": "number",
            "min": 0,
            "step": 1,
            "required": false,
            "essential": true,
            "defaultValue": 1
          },
          {
            "path": ["execution", "control", "todo", "required"],
            "label": {
              "zh-CN": "子代理必须先建立 Todo 计划",
              "en-US": "Require a Todo plan before work"
            },
            "description": {
              "zh-CN": "宿主会检查子代理是否写入计划，并在仍有未完成事项时将结果标记为部分完成。",
              "en-US": "The host verifies that the child wrote a plan and marks runs partial while work remains unfinished."
            },
            "type": "boolean",
            "defaultValue": false,
            "required": false,
            "essential": true
          },
          {
            "path": ["execution", "control", "todo", "minimumItems"],
            "label": {
              "zh-CN": "最少计划项",
              "en-US": "Minimum plan items"
            },
            "type": "number",
            "defaultValue": 1,
            "min": 1,
            "max": 256,
            "step": 1,
            "required": false,
            "essential": false
          },
          {
            "path": ["execution", "control", "budget", "maxModelTurns"],
            "label": {
              "zh-CN": "最大模型轮次",
              "en-US": "Maximum model turns"
            },
            "description": {
              "zh-CN": "达到上限后进入证据整理，不再开始新的调查。",
              "en-US": "Entering the limit starts evidence wrap-up and prevents new investigation."
            },
            "type": "number",
            "defaultValue": 32,
            "min": 1,
            "max": 4096,
            "step": 1,
            "required": false,
            "essential": true
          },
          {
            "path": ["execution", "control", "budget", "maxToolCalls"],
            "label": {
              "zh-CN": "最大工具调用数",
              "en-US": "Maximum tool calls"
            },
            "type": "number",
            "defaultValue": 128,
            "min": 1,
            "max": 16384,
            "step": 1,
            "required": false,
            "essential": true
          },
          {
            "path": ["execution", "control", "budget", "noProgressTurns"],
            "label": {
              "zh-CN": "无进展轮次",
              "en-US": "No-progress turns"
            },
            "description": {
              "zh-CN": "连续模型轮次没有新证据或计划变化时，自动请求收束。",
              "en-US": "Automatically requests wrap-up after consecutive turns without new evidence or plan changes."
            },
            "type": "number",
            "defaultValue": 3,
            "min": 1,
            "max": 256,
            "step": 1,
            "required": false,
            "essential": true
          },
          {
            "path": ["execution", "control", "budget", "noProgressTimeoutMs"],
            "label": {
              "zh-CN": "无进展超时",
              "en-US": "No-progress timeout"
            },
            "type": "number",
            "defaultValue": 180000,
            "min": 10000,
            "max": 3600000,
            "step": 10000,
            "required": false,
            "essential": false,
            "durationUnit": "milliseconds"
          },
          {
            "path": ["execution", "maxActivePerTree"],
            "label": {
              "zh-CN": "每棵代理树的活动上限",
              "en-US": "Active agents per tree"
            },
            "description": {
              "zh-CN": "达到上限时拒绝新任务，避免父子代理互等执行名额。",
              "en-US": "Reject new activations at capacity instead of waiting behind ancestors."
            },
            "type": "number",
            "defaultValue": 8,
            "min": 1,
            "step": 1,
            "required": false,
            "essential": true
          }
        ]
      },
      {
        "id": "workflows",
        "label": {
          "zh-CN": "工作流边界",
          "en-US": "Workflow limits"
        },
        "description": {
          "zh-CN": "默认不限制单个持久化子代理 DAG 的节点数；可按部署资源设置管理员配额。",
          "en-US": "Persisted child-agent DAGs have no default node-count limit. Administrators may set a deployment-specific quota."
        },
        "fields": [
          {
            "path": ["workflows", "maxNodes"],
            "label": {
              "zh-CN": "单工作流最大节点数",
              "en-US": "Maximum nodes per workflow"
            },
            "description": {
              "zh-CN": "留空表示不限；循环、重复节点和无效依赖仍会在启动任何子运行前被拒绝。",
              "en-US": "Leave empty for unlimited. Cycles, duplicate nodes, and invalid dependencies are still rejected before any child starts."
            },
            "type": "number",
            "min": 1,
            "step": 1,
            "required": false,
            "essential": true
          }
        ]
      }
    ]
  }
}
