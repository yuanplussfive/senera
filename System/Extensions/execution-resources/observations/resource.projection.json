{
  "$schema": "https://schemas.senera.ai/tool-observation-projection/v2.json",
  "schemaVersion": 2,
  "maxTokens": 128000,
  "maxOmissions": 128,
  "artifactFallback": {
    "strategy": "reference",
    "requiredWhenTruncated": true
  },
  "continuation": {
    "kind": "cursor",
    "handle": "/resourceId",
    "cursor": "/cursor",
    "state": "/state",
    "terminalStates": ["completed", "failed", "cancelled"]
  },
  "sources": [
    {
      "source": "continuation",
      "mode": "json",
      "priority": "essential",
      "maxTokens": 192,
      "limits": {
        "maxDepth": 3,
        "maxArrayItems": 0,
        "maxObjectProperties": 8,
        "maxNodes": 16
      },
      "requiredForCompletion": true
    },
    {
      "source": "summary",
      "mode": "text",
      "priority": "high",
      "maxTokens": 384,
      "limits": {
        "maxDepth": 1,
        "maxArrayItems": 0,
        "maxObjectProperties": 0,
        "maxNodes": 2
      },
      "requiredForCompletion": true
    },
    {
      "source": "result",
      "mode": "json",
      "priority": "normal",
      "maxTokens": 128000,
      "limits": {
        "maxDepth": 12,
        "maxArrayItems": 512,
        "maxObjectProperties": 512,
        "maxNodes": 4096
      },
      "requiredForCompletion": true
    }
  ]
}
