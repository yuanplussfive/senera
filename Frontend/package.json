{
  "name": "senera-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "android:sync": "tsx ../Build/StageMobileFrontend.ts && cap sync android",
    "android:open": "cap open android",
    "android:build": "tsx ../Apps/Mobile/PackageAndroid.ts",
    "android:release": "tsx ../Apps/Mobile/PackageAndroid.ts --release",
    "dev": "vite",
    "build": "tsc -b && vite build && tsx ../Build/VerifyFrontendBundleBudget.ts",
    "preview": "vite preview",
    "check.types": "tsc --noEmit",
    "check.governance": "node --import tsx ../Scripts/VerifyFrontendTestCoverage.ts",
    "check.ladle": "node --import tsx ../Scripts/VerifyFrontendLadleContracts.ts",
    "ui.registry.view": "shadcn view",
    "ui.registry.dry-run": "shadcn add --dry-run",
    "test.behavior": "node --import tsx ../Scripts/VerifyFrontendVitestSuite.ts",
    "test.governance": "npm run check.governance && npm run check.ladle",
    "test.static": "npm run check.types && npm run test.governance",
    "test.coverage": "vitest run --config ../vitest.config.ts --coverage",
    "test": "npm run test.static && npm run test.behavior",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "check.qq-types": "vue-tsc --noEmit -p qq/tsconfig.json",
    "build.qq-client": "npm run check.qq-types && vite build --mode qq-client"
  },
  "dependencies": {
