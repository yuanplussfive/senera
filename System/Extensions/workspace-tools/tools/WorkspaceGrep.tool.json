{
  "name": "WorkspaceGrep",
  "description": "Search file contents for a pattern. Returns matching lines with file paths and line numbers. Respects .gitignore. Output is truncated to 100 matches or 50KB (whichever is hit first). Long lines are truncated to 500 chars.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "pattern": { "type": "string", "description": "Search pattern (regex or literal string)" },
      "path": { "type": "string", "description": "Directory or file to search (default: current directory)" },
      "glob": { "type": "string", "description": "Filter files by glob pattern, e.g. '*.ts' or '**/*.spec.ts'" },
      "ignoreCase": { "type": "boolean", "description": "Case-insensitive search (default: false)" },
      "literal": {
        "type": "boolean",
        "description": "Treat pattern as literal string instead of regex (default: false)"
      },
      "context": {
        "type": "number",
        "description": "Number of lines to show before and after each match (default: 0)"
      },
      "limit": { "type": "number", "description": "Maximum number of matches to return (default: 100)" }
    },
    "required": ["pattern"],
    "additionalProperties": {}
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "content": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": { "type": "string", "const": "text" },
                "text": { "type": "string" },
                "textSignature": { "type": "string" }
              },
              "required": ["type", "text"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": { "type": "string", "const": "image" },
                "data": { "type": "string" },
                "mimeType": { "type": "string" }
              },
              "required": ["type", "data", "mimeType"],
              "additionalProperties": false
            }
          ]
        }
      },
      "details": {}
    },
    "required": ["content"],
    "additionalProperties": false
  },
  "observationProjection": "observations/WorkspaceGrep.projection.json",
  "permissions": ["filesystem:workspace:read"],
  "execution": { "Targets": ["Local"], "Network": "Deny", "Workspace": "ReadOnly" },
  "runtime": {
    "Lifecycle": "Immediate",
    "ProtocolVersion": 2,
    "ResultAssessment": "ProcessExit",
    "Scheduling": "Parallel",
    "Capabilities": { "Cancellation": true }
  },
  "resources": [{ "Capability": "senera.workspace.path", "Pointer": "/path", "Parameters": { "Intent": "read" } }],
  "sources": [],
  "search": {
    "Summary": "使用 Pi 原生 grep 和随包 ripgrep 搜索工作区内容，遵循 .gitignore。",
    "Tags": ["工作区", "文件读取", "代码搜索", "grep"],
    "Capabilities": [
      {
        "Id": "workspace.content.search",
        "Title": "Workspace content search",
        "Description": "Search workspace file contents with Pi's grep result and truncation semantics.",
        "Facets": {
          "Actions": ["search", "grep"],
          "Targets": ["workspace", "file-content"],
          "Inputs": ["pattern", "path", "glob", "context", "limit"],
          "Outputs": ["matching-lines", "file-paths", "line-numbers"],
          "Effects": ["none"]
        },
        "Aliases": ["grep", "搜索代码", "查找内容", "search code"],
        "Risk": { "SideEffect": "none", "Permission": "workspace-read" }
      }
    ],
    "UseCases": ["使用 Pi 原生 grep 和随包 ripgrep 搜索工作区内容，遵循 .gitignore。"],
    "Avoid": ["不要用于修改文件、执行构建或运行任意命令。"]
  },
  "evidenceCapabilities": []
}
