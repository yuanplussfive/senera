      "argumentPath": "command.script",
      "detailPaths": ["command.script", "cwd"],
      "labels": {
        "active": "workflow.toolActivity.shell.active",
        "completed": "workflow.toolActivity.shell.completed",
        "failed": "workflow.toolActivity.shell.failed"
      },
      "batchLabels": {
        "active": "workflow.toolBatch.shell.active",
        "completed": "workflow.toolBatch.shell.completed"
      }
    },
