{
  "$schema": "https://schemas.senera.ai/tool-observation-projection/v1.json",
  "schemaVersion": 1,
  "maxTokens": 2048,
  "maxOmissions": 16,
  "artifactFallback": {
    "strategy": "reference",
    "requiredWhenTruncated": true
  },
  "sources": [
    {
      "source": "summary",
      "mode": "text",
      "priority": "essential",
      "maxTokens": 384,
      "limits": {
        "maxDepth": 1,
        "maxArrayItems": 0,
        "maxObjectProperties": 0,
        "maxStringCharacters": 3072,
        "maxTotalCharacters": 3072,
        "maxNodes": 2
      }
    },
    {
      "source": "result",
      "mode": "json",
      "priority": "normal",
      "maxTokens": 1664,
      "limits": {
        "maxDepth": 7,
        "maxArrayItems": 48,
        "maxObjectProperties": 48,
        "maxStringCharacters": 2048,
        "maxTotalCharacters": 12288,
        "maxNodes": 512
      }
    }
  ]
}
