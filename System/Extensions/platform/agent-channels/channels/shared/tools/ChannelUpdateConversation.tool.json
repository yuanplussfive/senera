{
  "name": "ChannelUpdateConversation",
  "loading": "Bootstrap",
  "description": "Persist semantic task decisions for this conversation. Register independent requests as pending, supplements against their existing task, and unrelated chatter as ambient. Use only observed inbox sequence numbers. Task ownership comes from the original sender, not from tool arguments. Read current revisions before updates. Call alone in its batch. Reading a message never completes its task.",
  "presentation": {
    "category": "channel-message",
    "icon": "message",
    "activity": {
      "action": {
        "zh-CN": "更新对话事项",
        "en-US": "Update conversation tasks"
      },
      "argumentPath": "/title"
    }
  },
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "taskId": {
        "type": "string",
        "minLength": 1
      },
      "revision": {
        "type": "integer",
        "minimum": 1
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "status": {
        "type": "string",
        "enum": ["pending", "active", "waiting", "completed", "cancelled"]
      },
      "nextAction": {
        "type": ["string", "null"],
        "maxLength": 1024
      },
      "wakeAt": {
        "type": ["string", "null"],
        "format": "date-time"
      },
      "messages": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "relation": {
              "type": "string",
              "enum": ["request", "supplement", "ambient"]
            }
          },
          "required": ["sequence", "relation"],
          "additionalProperties": false
        }
      }
    },
    "required": ["messages"],
    "additionalProperties": false,
    "dependencies": {
      "taskId": ["revision"],
      "revision": ["taskId"]
    }
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "tasks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "status": {
              "enum": ["pending", "active", "waiting", "completed", "cancelled"]
            },
            "ownerId": {
              "type": "string"
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nextAction": {
              "type": "string"
            },
            "wakeAt": {
              "type": "string"
            },
            "createdSequence": {
              "type": "integer"
            },
            "updatedSequence": {
              "type": "integer"
            },
            "revision": {
              "type": "integer"
            }
          },
          "required": [
            "id",
            "title",
            "status",
            "ownerId",
            "participantIds",
            "createdSequence",
            "updatedSequence",
            "revision"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": ["tasks"],
    "additionalProperties": false
  },
  "permissions": ["channel:coordinate"],
  "execution": {
    "Targets": ["Local"],
    "Network": "Deny",
    "Workspace": "ReadOnly"
  },
  "runtime": {
    "Lifecycle": "Immediate",
    "ResultAssessment": "ProcessExit",
    "DeadlinePolicy": "ModelAware",
    "Scheduling": "SelfManaged"
  },
  "resources": [],
  "sources": [],
  "surfaces": ["channel"],
  "platforms": ["onebot11", "qq", "onebot"],
  "search": {
