{
  "ConfigVersion": 35,
  "Defaults": {
    "AgentLoop": {
      "PiTurnLeaseTimeoutSeconds": 120,
      "RunSettlementTimeoutSeconds": 15,
      "PiSessions": {
        "RootDir": ".senera/pi-sessions",
        "MaxCachedSessions": 8,
        "Compaction": {
          "Enabled": true
        }
      }
    },
    "Todos": {
      "MaxItems": 256,
      "MaxContentCharacters": 4000,
      "MaxResultCharacters": 512000
    },
    "ToolExecution": {
      "TimeoutSeconds": 120,
      "MaxConcurrentCallsPerRun": 10,
      "MaxStdoutBytes": 67108864,
      "MaxStderrBytes": 67108864,
      "SemanticAudit": {
        "Mode": "approval_sensitive"
      },
      "Environment": {
        "Inherit": "allowlist",
        "IncludeOnly": [
          "PATH",
          "HOME",
          "USER",
          "USERNAME",
          "USERPROFILE",
          "TMP",
          "TEMP",
          "TMPDIR",
          "SystemRoot",
          "ComSpec",
          "PATHEXT",
          "PWD",
          "TERM",
          "TERM_PROGRAM",
          "LANG",
          "LC_*",
          "CI"
        ],
        "Exclude": [],
        "Set": {}
      },
      "Resources": {
        "MaxActive": 8,
        "MaxBufferedBytes": 67108864,
        "OutputBatchMaxBytes": 65536,
        "OutputBatchMaxDelayMs": 50,
        "MaxInputBytes": 1048576,
        "InitialYieldSeconds": 1,
        "MaxWaitSeconds": 30,
        "IdleTtlSeconds": 1800,
        "TerminalTtlSeconds": 300,
        "SweepIntervalSeconds": 30,
        "TerminationGraceSeconds": 2
      }
    },
    "McpConnections": {
      "IdleTtlSeconds": 1800,
      "SweepIntervalSeconds": 30
    },
    "SandboxRuntime": {
      "Enabled": true,
      "BaseDir": ".senera/sandbox-runtime"
    },
    "ToolSearch": {
      "Fuzzy": {
        "Enabled": true,
        "MinScore": 0.25
      },
      "Memory": {
        "MaxEpisodes": 5000,
        "HalfLifeDays": 30
      },
      "Ranking": {
        "RrfK": 30
      },
      "Disclosure": {
        "TokenBudget": 640
      },
      "Rerank": {
        "Enabled": true,
        "ScoreScale": 0.018,
        "FeatureWeights": {}
      }
    },
    "StateCard": {
      "Enabled": true,
      "HistoryBudgetCharacters": 4000
    },
    "ContinuityLearning": {
      "Enabled": true,
      "Runtime": {
        "MaxAttempts": 3,
        "RetryBaseDelaySeconds": 1,
        "RetryMaxDelaySeconds": 60,
        "MaxJobsPerDrain": 8
      },
      "MemOS": {
        "AutoLinkThreshold": 0.75
      },
      "Recall": {
        "PromptBudget": {
          "MaxTokens": 16384
        }
      }
    },
    "Artifacts": {
      "RootDir": ".senera/artifacts/runs",
      "ToolObservationMaxTokens": 16384,
      "RawJsonMaxBytes": 67108864,
      "TextFileMaxBytes": 67108864,
      "WorkspaceObserverMemoryMaxBytes": 67108864,
      "WorkspaceObserverSettleMs": 80,
      "WorkspaceObserverIdleTtlMs": 30000,
      "WorkspaceObserverIgnoredPaths": [".git", ".agents", ".claude", ".codex"],
      "WorkspacePatchContextLines": 3,
      "MemoryReadMaxArtifacts": 16,
      "MemoryReadMaxConcurrency": 4,
      "MaxStoredBytes": 10737418240,
      "MaxArtifacts": 10000,
      "RetentionHours": 720,
      "IncompleteRetentionHours": 24,
      "MaintenanceIntervalMinutes": 15,
      "MaintenanceMaxConcurrency": 4
    },
    "Uploads": {
      "RootDir": ".senera/uploads",
      "MaxFileBytes": 52428800,
      "MaxRequestBytes": 104857600,
      "MaxFilesPerRequest": 8,
      "MaxConcurrentUploads": 4,
      "MaxStoredBytes": 2147483648,
      "RetentionHours": 720,
      "MaintenanceIntervalMinutes": 15
    },
    "Frontend": {
      "DevServer": {
        "Host": "127.0.0.1",
        "Port": 5173,
        "StrictPort": false
      },
      "PreviewServer": {
        "Host": "127.0.0.1",
        "Port": 4173,
        "StrictPort": true
      },
      "Client": {
        "WebSocketUrl": "ws://127.0.0.1:8787",
        "ModelLabel": "senera",
        "UserName": "you",
        "EmptySuggestions": ["整理今天的工作优先级", "分析一段错误日志", "把需求拆成可执行步骤"]
      }
    },
    "ActionPlanner": {
      "Enabled": true,
      "MaxRepairAttempts": 1,
      "Client": {
        "Temperature": 0.1,
        "MaxTokens": -1
      },
      "FinalAnswerClient": {
        "Temperature": 0.1,
        "MaxTokens": -1
      }
    },
    "Server": {
      "Host": "127.0.0.1",
      "Port": 8787,
      "HotReload": true,
      "RequestMaxBytes": 67108864,
      "AccessControl": {
        "Mode": "auto",
        "AccountFile": ".senera/access/admin-account.json",
        "AllowedOrigins": [],
        "TrustedProxyAddresses": [],
        "AllowInsecureLoopback": false,
        "AllowInsecureHttp": false,
        "Session": {
          "AbsoluteTtlHours": 72,
          "IdleTtlHours": 12,
          "MaxSessions": 8
        },
        "Limits": {
          "MaxConnections": 64,
          "MaxConnectionsPerClient": 8,
          "UpgradeRequestsPerMinute": 30,
          "HttpRequestsPerMinute": 60,
          "MessagesPerMinute": 100,
          "LoginAttemptsPerMinute": 5,
          "HeartbeatIntervalSeconds": 30,
          "IdleSocketTimeoutSeconds": 90
        }
      }
    },
    "Persistence": {
      "Kind": "sqlite",
      "EventWriter": {
        "RestartDelayMs": 250,
        "CloseTimeoutMs": 5000,
        "DrainBatchSize": 256,
        "CommittedRetentionMs": 604800000
      }
    },
    "ConfigStore": {
      "Enabled": true,
      "Kind": "sqlite",
      "MirrorJson": true,
      "RevisionRetentionCount": 256,
      "CommandReceiptRetentionHours": 168,
      "CommandReceiptMaxCount": 4096
    }
  },
  "DefaultModelProviderId": "main",
  "ModelProviderEndpoints": [
    {
      "Id": "main",
      "BaseUrl": "http://localhost:3000/v1",
      "ApiKey": "YOUR_API_KEY"
    }
  ],
  "ModelProviders": [
    {
      "Id": "main",
      "ProviderId": "main",
      "Capabilities": {
        "ToolCalling": true,
        "DeveloperRole": false,
        "StreamingUsage": true
      },
      "ToolPlanningMode": "native",
      "Endpoint": "ChatCompletions",
      "Model": "YOUR_MODEL_ID",
      "MaxOutputTokens": -1,
      "MaxNetworkRetries": 1,
      "RetryBaseDelaySeconds": 0.25,
      "RetryMaxDelaySeconds": 10,
      "RetryAfterMaxDelaySeconds": 60
    }
  ],
  "Extensions": {
    "agent-channels": {
      "Enabled": true,
      "Configuration": {
        "enabled": true,
        "qq": {
          "enabled": false,
          "appId": "your-qq-bot-app-id",
          "appSecret": "your-qq-bot-app-secret",
          "mode": "websocket",
          "allowAllUsers": true
        },
        "telegram": {
          "enabled": false,
          "token": "your-telegram-bot-token"
        },
        "discord": {
          "enabled": false,
          "token": "your-discord-bot-token"
        }
      }
    }
  }
}
