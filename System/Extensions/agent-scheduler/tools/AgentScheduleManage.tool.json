{
  "name": "AgentScheduleManage",
  "description": "创建、更新、列出、检查、立即运行或删除当前会话拥有的持久化定时代理任务。",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "action": { "type": "string", "const": "create" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["cron", "once", "interval"] },
          "schedule": { "type": "string", "minLength": 1 },
          "enabled": { "default": true, "type": "boolean" },
          "modelProviderId": { "type": "string", "minLength": 1 },
          "allowedToolNames": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
          "timeoutMs": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["action", "prompt", "type", "schedule"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "action": { "type": "string", "const": "update" },
          "taskId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["cron", "once", "interval"] },
          "schedule": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "modelProviderId": { "type": "string", "minLength": 1 },
          "allowedToolNames": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
          "timeoutMs": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["action", "taskId"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["get", "delete", "run_now"] },
          "taskId": { "type": "string", "minLength": 1 }
        },
        "required": ["action", "taskId"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": { "action": { "type": "string", "enum": ["list", "status"] } },
        "required": ["action"],
        "additionalProperties": false
      }
    ]
  },
  "outputSchema": { "type": "object", "additionalProperties": true },
  "observationProjection": "observations/AgentScheduleManage.projection.json",
  "permissions": ["orchestration:schedule"],
  "execution": { "Targets": ["Local"], "Network": "Deny", "Workspace": "ReadOnly" },
  "runtime": {
    "Lifecycle": "Persistent",
    "ProtocolVersion": 2,
    "ResultAssessment": "Unassessed",
    "Scheduling": "SelfManaged",
    "Capabilities": { "Progress": true, "Cancellation": true, "ResumableEvents": true }
  },
  "resources": [],
  "sources": [
    {
      "Id": "orchestration.scheduler",
      "Title": "Agent task scheduling",
      "Description": "Scheduled agent tasks managed by Senera."
    }
  ],
  "search": {
    "Summary": "管理 cron、单次和间隔触发的持久化代理任务。",
    "Capabilities": [
      {
        "Id": "orchestration.schedule-manage",
        "Title": "Persistent agent scheduling",
        "Description": "Manage scheduled prompts with SQLite persistence and Senera execution policy.",
        "Facets": {
          "Actions": ["schedule", "list", "inspect", "update", "run", "delete"],
          "Targets": ["scheduled-task", "cron", "interval", "automation"],
          "Inputs": ["prompt", "schedule", "model"],
          "Outputs": ["scheduled-task", "run-status"],
          "Effects": ["persistent-state", "future-model-call"]
        },
        "Aliases": ["定时任务", "计划任务", "cron agent", "schedule prompt"],
        "Risk": { "SideEffect": "persistent-state", "Permission": "orchestration" }
      }
    ],
    "UseCases": ["用户明确要求定时、延迟或周期执行代理任务时。"],
    "Avoid": ["用户没有要求持久化执行时不要创建任务。", "不要把完整访问权限写入计划任务。"],
    "Tags": ["定时任务", "自动化", "cron", "持久调度"]
  },
  "evidenceCapabilities": [],
  "approval": { "Mode": "ask", "Reason": "创建或修改会在未来自动运行的持久任务。" }
}
