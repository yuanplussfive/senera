{
  "version": 4,
  "maxVisibleBatchIcons": 3,
  "defaultCategory": "tools",
  "defaultActivityGroup": "tools",
  "originIcons": {
    "mcp": "globe"
  },
  "activityGroups": [
    {
      "id": "explore",
      "icon": "search",
      "title": "workflow.stage.activityGroup.explore",
      "activityCategories": [
        "workspace-search",
        "workspace-find",
        "workspace-read",
        "workspace-list",
        "git-inspect",
        "tool-search"
      ]
    },
    {
      "id": "change",
      "icon": "pencil",
      "title": "workflow.stage.activityGroup.change",
      "activityCategories": ["workspace-write", "git-mutate"]
    },
    {
      "id": "execute",
      "icon": "terminal",
      "title": "workflow.stage.activityGroup.execute",
      "activityCategories": [
        "shell",
        "terminal-start",
        "execution-inspect",
        "execution-wait",
        "execution-input",
        "execution-control",
        "execution-resource"
      ]
    },
    {
      "id": "delegate",
      "icon": "users",
      "title": "workflow.stage.activityGroup.delegate",
      "activityCategories": [
        "delegation",
        "agent-spawn",
        "agent-wait",
        "agent-input",
        "agent-stop",
        "agent-resume",
        "agent-contact-supervisor"
      ]
    },
    {
      "id": "external",
      "icon": "globe",
      "title": "workflow.stage.activityGroup.external",
      "activityCategories": [
        "mcp",
        "web-search",
        "web-fetch",
        "browser-navigation",
        "browser-read",
        "browser-interaction",
        "browser-wait",
        "browser-screenshot",
        "browser-tabs",
        "browser-session",
        "browser-computer",
        "browser-download"
      ]
    },
    {
      "id": "knowledge",
      "icon": "brain",
      "title": "workflow.stage.activityGroup.knowledge",
      "activityCategories": [
        "learning-manage",
        "artifact-read",
        "memory-read",
        "memory-write",
        "document-extract",
        "image-analysis"
      ]
    },
    {
      "id": "interaction",
      "icon": "message-question",
      "title": "workflow.stage.activityGroup.interaction",
      "activityCategories": ["ask-user", "schedule-manage"]
    },
    {
      "id": "tools",
      "icon": "tools",
      "title": "workflow.stage.activityGroup.tools",
      "activityCategories": ["system", "tool-describe", "tool-load", "tool-unload", "skill-manage"]
    }
  ],
  "singleToolLabels": {
    "active": "workflow.stage.singleTool.active",
    "completed": "workflow.stage.singleTool.completed"
  },
  "categories": [
    {
      "id": "tools",
      "icon": "tools",
      "match": {},
      "labels": {
        "active": "workflow.stage.tools.active",
        "completed": "workflow.stage.tools.completed"
      }
    },
    {
      "id": "web-search",
      "icon": "search",
      "match": { "exactToolNames": ["WebSearch"] },
      "labels": {
        "active": "workflow.stage.webSearch.active",
        "completed": "workflow.stage.webSearch.completed"
      }
    },
    {
      "id": "web-fetch",
      "icon": "globe",
      "match": { "exactToolNames": ["WebFetch"] },
      "labels": {
        "active": "workflow.stage.webFetch.active",
        "completed": "workflow.stage.webFetch.completed"
      }
    },
    {
      "id": "browser",
      "icon": "globe",
      "match": { "toolNamePrefixes": ["Browser"] },
      "labels": {
        "active": "workflow.stage.browser.active",
        "completed": "workflow.stage.browser.completed"
      }
    },
    {
      "id": "tool-discovery",
      "icon": "search",
      "match": { "exactToolNames": ["ToolSearch"] },
      "labels": {
        "active": "workflow.stage.toolDiscovery.active",
        "completed": "workflow.stage.toolDiscovery.completed"
      }
    },
    {
      "id": "tool-management",
      "icon": "tools",
      "match": { "exactToolNames": ["ToolDescribe", "ToolLoad", "ToolUnload"] },
      "labels": {
        "active": "workflow.stage.tools.active",
        "completed": "workflow.stage.tools.completed"
      }
    },
    {
      "id": "skill-search",
      "icon": "blocks",
      "match": { "exactToolNames": ["SkillSearch", "SkillSearchTool"] },
      "labels": {
        "active": "workflow.stage.skillSearch.active",
        "completed": "workflow.stage.skillSearch.completed"
      }
    },
    {
      "id": "skill-management",
      "icon": "blocks",
      "match": { "exactToolNames": ["SkillManage"] },
      "labels": {
        "active": "workflow.stage.skillManagement.active",
        "completed": "workflow.stage.skillManagement.completed"
      }
    },
    {
      "id": "workspace-search",
      "icon": "search",
      "match": { "exactToolNames": ["WorkspaceFind", "WorkspaceGrep"] },
      "labels": {
        "active": "workflow.stage.workspaceSearch.active",
        "completed": "workflow.stage.workspaceSearch.completed"
      }
    },
    {
      "id": "workspace-read",
      "icon": "file-text",
      "match": {
        "exactToolNames": ["ArtifactReadTool", "WorkspaceList", "WorkspaceRead"]
      },
      "labels": {
        "active": "workflow.stage.workspaceRead.active",
        "completed": "workflow.stage.workspaceRead.completed"
      }
    },
    {
      "id": "workspace-write",
      "icon": "pencil",
      "match": { "exactToolNames": ["WorkspaceApplyPatch"] },
      "labels": {
        "active": "workflow.stage.workspaceWrite.active",
        "completed": "workflow.stage.workspaceWrite.completed"
      }
    },
    {
      "id": "command",
      "icon": "terminal",
      "match": { "exactToolNames": ["ShellCommandTool", "TerminalStartTool"] },
      "labels": {
        "active": "workflow.stage.command.active",
        "completed": "workflow.stage.command.completed"
      }
    },
    {
      "id": "background-wait",
      "icon": "clock",
      "match": { "exactToolNames": ["AgentWait", "ExecutionResourceWait"] },
      "labels": {
        "active": "workflow.stage.backgroundWait.active",
        "completed": "workflow.stage.backgroundWait.completed"
      }
    },
    {
      "id": "background-task",
      "icon": "activity",
      "match": { "toolNamePrefixes": ["ExecutionResource"] },
      "labels": {
        "active": "workflow.stage.backgroundTask.active",
        "completed": "workflow.stage.backgroundTask.completed"
      }
    },
    {
      "id": "version-control",
      "icon": "git-branch",
      "match": { "toolNamePrefixes": ["Git"] },
      "labels": {
        "active": "workflow.stage.versionControl.active",
        "completed": "workflow.stage.versionControl.completed"
      }
    },
    {
      "id": "delegation",
      "icon": "users",
      "match": {
        "stepKinds": ["delegation"],
        "toolNamePrefixes": ["AgentContact", "AgentInput", "AgentList", "AgentResume", "AgentSpawn", "AgentStop"]
      },
      "labels": {
        "active": "workflow.stage.delegation.active",
        "completed": "workflow.stage.delegation.completed"
      }
    },
    {
      "id": "memory",
      "icon": "brain",
      "match": {
        "exactToolNames": ["LearningManage", "MemoryRecallTool", "MemoryWriteTool"]
      },
      "labels": {
        "active": "workflow.stage.memory.active",
        "completed": "workflow.stage.memory.completed"
      }
    },
    {
      "id": "schedule",
      "icon": "calendar-clock",
      "match": { "exactToolNames": ["AgentScheduleManage"] },
      "labels": {
        "active": "workflow.stage.schedule.active",
        "completed": "workflow.stage.schedule.completed"
      }
    },
    {
      "id": "document",
      "icon": "file-text",
      "match": { "exactToolNames": ["DocumentExtract"] },
      "labels": {
        "active": "workflow.stage.document.active",
        "completed": "workflow.stage.document.completed"
      }
    },
    {
      "id": "image",
      "icon": "image",
      "match": { "exactToolNames": ["ImageAnalyze"] },
      "labels": {
        "active": "workflow.stage.image.active",
        "completed": "workflow.stage.image.completed"
      }
    },
    {
      "id": "interaction",
      "icon": "message-question",
      "match": { "exactToolNames": ["AskUserTool"] },
      "labels": {
        "active": "workflow.stage.interaction.active",
        "completed": "workflow.stage.interaction.completed"
      }
    }
  ]
}
