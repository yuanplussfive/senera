{
  "manifest_version": "0.3",
  "name": "zavora-computer-use",
  "display_name": { "zh-CN": "Zavora 桌面控制", "en-US": "Zavora Computer Use" },
  "version": "7.1.0",
  "description": {
    "zh-CN": "完整接入 Zavora 的跨平台桌面控制能力，包括屏幕、输入、窗口、应用、界面自动化、文件、脚本和任务管理。",
    "en-US": "Full Zavora cross-platform computer-use capabilities for screens, input, windows, apps, UI automation, files, scripts, and tasks."
  },
  "author": {
    "name": "Senera"
  },
  "server": {
    "type": "node",
    "entry_point": "mcp/server.mjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/mcp/server.mjs"]
    }
  },
  "_meta": {
    "ai.senera/presentation": {
      "icon": "computer-desktop"
    },
    "ai.senera/execution": {
      "targets": ["local"],
      "preferred": "local"
    },
    "ai.senera/requirements": {
      "hostCapabilities": ["interactive-desktop"]
    },
    "ai.senera/runtime-assets": {
      "node_modules": [
        {
          "package": "@zavora-ai/computer-use-mcp",
          "files": [
            "computer-use-napi.darwin-arm64.node",
            "computer-use-napi.darwin-x64.node",
            "computer-use-napi.linux-arm64.node",
            "computer-use-napi.linux-x64.node",
            "computer-use-napi.win32-arm64.node",
            "computer-use-napi.win32-x64.node"
          ]
        }
      ]
    },
    "ai.senera/tool-i18n": {
      "screenshot": ["截图", "屏幕截图", "捕获屏幕", "截个屏", "截屏"],
      "get_tool_guide": ["工具指南", "使用说明", "操作指南"],
      "open_application": ["打开应用", "启动程序", "运行应用", "打开软件", "启动软件", "打开程序"],
      "openai_computer": ["打开AI助手", "运行AI", "启动助手"],
      "activate_window": ["激活窗口", "切换窗口", "聚焦窗口", "把窗口切到前台"],
      "click_element": ["点击元素", "点击", "鼠标点击", "点一下", "单击"],
      "left_click": ["左键点击", "左键", "点击左键", "点左键"],
      "double_click": ["双击", "双击元素"],
      "find_element": ["查找元素", "定位元素", "搜索界面元素", "找元素", "定位界面元素"],
      "get_ui_tree": ["获取界面树", "UI树", "控件树", "界面结构"],
      "get_app_capabilities": ["应用能力", "程序功能", "应用功能"],
      "list_running_apps": ["运行中的应用", "进程列表", "正在运行的程序", "查看运行中的程序"],
      "list_windows": ["窗口列表", "列出窗口", "窗口"],
