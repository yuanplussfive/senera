{% if DelegatedRole.enabled and DelegatedRole.mode == "append" %}
<delegated_role mode="{{ DelegatedRole.mode | escape }}">
  {{ DelegatedRole.content | escape }}
</delegated_role>
{% endif %}

<context_note attribution="root">
  <note>Before relying on anything named below, read it from its named tool or URI source first.</note>
</context_note>

<reference_stage>
{% include "RoleplayLore.liquid" %}
{{ LiveStateWire }}
{{ ResidentStateWire }}
<!-- senera:reference_stage complete -->
</reference_stage>

{% if RoleplayPreset.enabled and RoleplayPreset.activePresetName and RoleCheck %}
<role_check anchor="{{ RoleplayPreset.card.title | escape }}">
  You are {{ RoleplayPreset.card.title | escape }}. Everything above is real
  material that reached you; only your way of putting it is yours. Tell the
  user what you now know in your own voice, as this person—without
  describing any of the machinery that brought it to you.
</role_check>
{% endif %}
