{
  "name": "DocumentExtract",
  "loading": "Bootstrap",
  "description": "Probe or extract a document from an authorized local path, canonical Senera resource, or public HTTP(S) URL. Extraction returns one content view in the requested format (Markdown by default), with truncation and parser warnings. Other representations and parser diagnostics remain in the saved result. Use an attachment's exact local_path or resource_uri.",
  "presentation": {
    "category": "document-extract",
    "icon": "file-text",
    "activity": {
      "action": { "zh-CN": "提取", "en-US": "Extract" },
      "argumentPath": "/source/path",
      "detailPaths": ["/source/uri", "/source/url", "/mode"]
    },
    "preview": { "body": { "pointer": "/document", "from": "result" } }
  },
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "format": {
        "type": "string",
        "enum": ["markdown", "text"],
        "default": "markdown",
        "description": "Content representation returned to the model for extraction."
      },
      "source": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "senera_resource" },
              "uri": {
                "type": "string",
                "pattern": "^senera:\\/\\/resource\\/[A-Za-z0-9][A-Za-z0-9._~-]{0,255}$",
                "description": "Canonical Senera resource identity."
              },
              "path": {
                "description": "Workspace-relative path of the stored resource. Read it directly instead of resolving the URI again.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["kind", "uri"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "local_path" },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Workspace-relative or absolute local path subject to the active resource access policy."
              }
            },
            "required": ["kind", "path"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "http_url" },
              "url": {
                "type": "string",
                "pattern": "^https?:\\/\\/\\S+$",
                "description": "Public HTTP(S) resource URL; private hosts remain subject to runtime policy."
              }
            },
            "required": ["kind", "url"],
            "additionalProperties": false
          }
        ],
        "description": "Document source: workspace-local path, Senera resource, or HTTP(S) URL."
      },
      "mode": { "default": "auto", "type": "string", "enum": ["auto", "probe", "extract"] }
    },
    "required": ["source"],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "x-senera-model-output": {
      "omit": [
        "/document/sha256",
        "/document/extraction/parser",
        "/document/extraction/fileType",
        "/document/extraction/textPreview",
        "/document/extraction/markdownPreview",
        "/document/extraction/textLength",
        "/document/extraction/markdownLength",
        "/document/extraction/chunks"
      ]
    },
    "type": "object",
    "properties": {
      "document": {
        "type": "object",
        "properties": {
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "senera_resource" },
                  "uri": {
                    "type": "string",
                    "pattern": "^senera:\\/\\/resource\\/[A-Za-z0-9][A-Za-z0-9._~-]{0,255}$",
                    "description": "Canonical Senera resource identity."
                  },
                  "path": {
                    "description": "Workspace-relative path of the stored resource. Read it directly instead of resolving the URI again.",
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["kind", "uri"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "local_path" },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Workspace-relative or absolute local path subject to the active resource access policy."
                  }
                },
                "required": ["kind", "path"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "http_url" },
                  "url": {
                    "type": "string",
                    "pattern": "^https?:\\/\\/\\S+$",
                    "description": "Public HTTP(S) resource URL; private hosts remain subject to runtime policy."
                  }
                },
                "required": ["kind", "url"],
                "additionalProperties": false
              }
            ]
          },
          "name": { "type": "string" },
          "mime": { "type": "string" },
          "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "sha256": { "type": "string" },
          "status": { "type": "string", "enum": ["probed", "extracted"] },
          "content": {
            "type": "object",
            "properties": {
              "format": { "type": "string", "enum": ["markdown", "text"] },
              "text": { "type": "string" },
              "truncated": { "type": "boolean" }
            },
            "required": ["format", "text", "truncated"],
            "additionalProperties": false
          },
          "probe": { "type": "object", "properties": {}, "additionalProperties": {} },
          "extraction": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "const": "extracted" },
              "parser": { "type": "string" },
              "fileType": { "type": "string" },
              "textPreview": { "type": "string" },
              "markdownPreview": { "type": "string" },
              "textLength": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "markdownLength": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "metadata": { "type": "object", "propertyNames": { "type": "string" }, "additionalProperties": {} },
              "structure": {
                "type": "object",
                "properties": {
                  "topLevelNodeCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "attachmentCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "warningCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                },
                "required": ["topLevelNodeCount", "attachmentCount", "warningCount"],
                "additionalProperties": false
              },
              "chunks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "text": { "type": "string" },
                    "length": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "metadata": { "type": "object", "propertyNames": { "type": "string" }, "additionalProperties": {} }
                  },
                  "required": ["index", "text", "length"],
                  "additionalProperties": false
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "enum": ["warning", "info", "error"] },
                    "code": { "type": "string" },
                    "message": { "type": "string" }
                  },
                  "required": ["type", "code", "message"],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "status",
              "parser",
              "fileType",
              "textPreview",
              "markdownPreview",
              "textLength",
              "markdownLength",
              "metadata",
              "structure",
              "chunks",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "required": ["source", "name", "mime", "size", "sha256", "status", "probe"],
        "additionalProperties": false
      }
    },
    "required": ["document"],
    "additionalProperties": false
  },
  "permissions": ["resources:read"],
  "execution": { "Targets": ["Local"], "Network": "Allow", "Workspace": "ReadOnly" },
  "runtime": {
    "Lifecycle": "Immediate",
    "ResultAssessment": "ProcessExit",
    "Scheduling": "Parallel"
  },
  "resources": [{ "Capability": "senera.resource.source", "Pointer": "/source" }],
  "sources": [],
  "search": {
    "Summary": "读取文档的类型、结构、元数据和文本内容，必要时提取可检索的 Markdown。",
    "Tags": ["document", "extract", "text", "metadata"],
    "Capabilities": [
      {
        "Id": "document.extract",
        "Title": "Document extraction",
        "Description": "检查文档并提取文本、结构、元数据和解析警告。",
        "Facets": {
          "Actions": ["probe", "extract", "inspect"],
          "Targets": ["workspace-document-path", "document-resource", "public-document-url"],
          "Inputs": ["source", "mode"],
          "Outputs": ["document-metadata", "text", "markdown", "structure", "warnings"],
          "Effects": ["none"]
        },
        "Aliases": ["读取文档", "提取文本", "解析文件", "document extraction"],
        "Risk": { "SideEffect": "read-only", "Permission": "resources-read" }
      }
    ],
    "UseCases": ["用户提供文档资源，并希望查看内容、结构、元数据或解析警告。"],
    "Avoid": ["不要读取工作区以外的本地路径或绕过网络安全策略；需要修改文档时使用对应的工作区工具。"]
  },
  "evidenceCapabilities": []
}
