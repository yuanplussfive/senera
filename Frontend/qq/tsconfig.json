{
  "include": [
    "../src/vite-env.d.ts",
    "../src/types/react-jsx-compat.d.ts",
    "client/src/renderer/src/env.d.ts",
    "client/src/renderer/src/**/*",
    "client/src/renderer/src/**/*.vue"
  ],
  "exclude": ["client/src/renderer/src/assets/img/qq-face/**/*"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "bundler",
    "paths": {
      "@renderer/*": ["./client/src/renderer/src/*"],
      "@senera-product": ["./product.ts"]
    }
  }
}
