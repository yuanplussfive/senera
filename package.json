{
  "name": "senera",
  "version": "1.13.1",
  "description": "Observable, verifiable agent runtime and desktop workbench.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuanplussfive/senera.git"
  },
  "senera": {
    "update": {
      "repositoryUrl": "https://github.com/yuanplussfive/senera",
      "trustedRedirectHosts": [
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com"
      ]
    },
    "containerImage": "ghcr.io/yuanplussfive/senera"
  },
  "workspaces": [
    "Packages/*",
    "Frontend"
  ],
  "main": "Dist/Source/AgentSystem/Runtime/AgentSystemRuntime.js",
  "bin": {
    "senera": "Dist/Apps/SeneraCli.js"
  },
  "exports": {
    ".": {
      "types": "./Source/AgentSystem/Runtime/AgentSystemRuntime.ts",
      "import": "./Dist/Source/AgentSystem/Runtime/AgentSystemRuntime.js",
      "default": "./Dist/Source/AgentSystem/Runtime/AgentSystemRuntime.js"
    }
  },
  "scripts": {
    "clean": "rimraf Dist",
    "quality.baml": "baml check --from baml_src",
    "quality.baml.generate": "baml generate --from baml_src",
    "quality.security": "npm audit --package-lock-only --audit-level=moderate",
    "quality.coverage": "npm run test.coverage.frontend && npm run test.coverage.backend && npm run quality.coverage.ratchet",
    "quality.coverage.ratchet": "tsx Scripts/VerifyCoverageRatchet.ts",
    "quality.coverage.ratchet.apply": "tsx Scripts/VerifyCoverageRatchet.ts --apply",
    "quality.lint": "eslint . --cache --cache-location .cache/eslint/.eslintcache --cache-strategy content --max-warnings=0",
    "quality.lint.fix": "npm run quality.lint -- --fix",
    "quality.commits": "commitlint",
    "quality.format": "tsx Scripts/VerifyChangedFormatting.ts",
    "quality.format.fix": "tsx Scripts/VerifyChangedFormatting.ts --write",
    "quality.format.full": "prettier \"**/*\" --check --ignore-unknown",
    "quality.format.full.fix": "prettier \"**/*\" --write --ignore-unknown",
    "quality.docs": "tsx Scripts/VerifyDocumentation.ts",
    "policy.compile": "tsx Build/CompileOpaPolicy.ts",
    "policy.verify": "tsx Build/CompileOpaPolicy.ts --check",
    "generate.frontend-events": "tsx Build/GenerateFrontendEventCatalog.ts",
    "generate.resource-contract": "tsx Build/GenerateResourceContract.ts",
    "generate.database-contracts": "tsx Build/GenerateDatabaseContracts.ts",
    "generate.system-extension-contracts": "tsx Build/GenerateSystemExtensionContracts.ts",
    "generate.config-command-contracts": "tsx Build/GenerateConfigCommandContracts.ts",
    "generate.protocol-reference": "tsx Build/GenerateWebSocketProtocolReference.ts",
    "generate.nano": "tsx Build/Distributions/GenerateNanoDistribution.ts --output",
    "generate.update-manifest": "tsx Build/GenerateProductUpdateManifest.ts",
    "verify.database-contracts": "tsx Build/GenerateDatabaseContracts.ts --check",
    "verify.system-extension-contracts": "tsx Build/GenerateSystemExtensionContracts.ts --check",
    "verify.config-command-contracts": "tsx Build/GenerateConfigCommandContracts.ts --check",
    "verify.config-form": "tsx Scripts/VerifyAgentConfigFormProjection.ts",
    "verify.frontend-events": "tsx Build/GenerateFrontendEventCatalog.ts --check",
    "verify.resource-contract": "tsx Build/GenerateResourceContract.ts --check",
    "verify.protocol-reference": "tsx Build/GenerateWebSocketProtocolReference.ts --check",
    "verify.i18n": "tsx Scripts/VerifyAgentErrorI18n.ts && tsx Scripts/VerifyFrontendErrorI18n.ts && tsx Scripts/VerifyAgentRuntimeI18n.ts && tsx Scripts/VerifyFrontendRuntimeI18n.ts",
    "access.admin": "tsx Apps/AdminAccess.ts",
    "maintenance.pi-sessions": "tsx Apps/PiSessionMaintenance.ts",
    "maintenance.pi-sessions.apply": "tsx Apps/PiSessionMaintenance.ts --apply",
    "maintenance.pi-sessions.json": "tsx Apps/PiSessionMaintenance.ts --output=json",
    "maintenance.artifacts": "tsx Apps/ArtifactMaintenance.ts",
    "maintenance.artifacts.apply": "tsx Apps/ArtifactMaintenance.ts --apply",
    "maintenance.artifacts.json": "tsx Apps/ArtifactMaintenance.ts --output=json",
    "benchmark.tool-search": "tsx Apps/ToolSearchBenchmark.ts",
    "sandbox.prepare": "tsx Build/PrepareSandboxRuntime.ts",
    "verify.sandbox.real": "npm run build && npm run sandbox.prepare && tsx Scripts/VerifySeneraDockerEngineRealTerminal.ts",
    "check.types": "tsc --noEmit",
    "build": "npm run verify.config-command-contracts && npm run verify.config-form && npm run verify.database-contracts && npm run verify.system-extension-contracts && npm run verify.frontend-events && npm run verify.resource-contract && npm run verify.protocol-reference && npm run verify.i18n && npm run clean && tsc && tsx Build/CopyRuntimeAssets.ts",
    "dev": "concurrently -k -n server,frontend -c blue,green \"npm run dev.server\" \"npm run dev.frontend\"",
    "docker.up": "docker compose pull && docker compose up -d",
    "docker.down": "docker compose down",
    "docker.logs": "docker compose logs -f senera",
    "dev.frontend": "npm --workspace senera-frontend run dev",
    "check.frontend-types": "npm --workspace senera-frontend run check.types",
    "test.frontend": "npm --workspace senera-frontend run test",
    "test.frontend.governance": "npm --workspace senera-frontend run test.governance",
    "test.frontend.static": "npm --workspace senera-frontend run test.static",
    "test.coverage.frontend": "npm --workspace senera-frontend run test.coverage",
    "test.backend": "vitest run --config vitest.backend.config.ts",
    "test.coverage.backend": "vitest run --config vitest.backend.config.ts --coverage",
    "test.integration": "vitest run --config vitest.integration.config.ts",
    "test.e2e.web.setup": "playwright install chromium",
    "test.e2e.web.run": "playwright test --config playwright.config.ts --project chromium",
    "test.e2e.web": "npm run build && npm --workspace senera-frontend run build && npm run test.e2e.web.run",
    "test.e2e.desktop.run": "playwright test --config playwright.config.ts --project electron",
    "test.e2e.desktop": "npm run build && npm --workspace senera-frontend run build && npm run test.e2e.desktop.run",
    "test.e2e": "npm run test.integration && npm run test.e2e.web",
    "test.all": "npm test && npm run test.e2e",
    "server": "npm run build && node Dist/Apps/Server.js",
    "dev.server": "tsx Apps/ServerWatch.ts",
    "dev.server.dry-run": "tsx Apps/ServerWatch.ts --dry-run",
    "desktop": "tsx Apps/Desktop/RunDesktop.ts",
    "desktop.prepare-native": "tsx Build/PrepareElectronNativeModules.ts",
    "desktop.prepare-mcp-runtime": "tsx Build/PrepareDesktopMcpRuntime.ts",
    "desktop.pack": "tsx Apps/Desktop/PackageDesktop.ts",
    "verify.suite": "node Dist/Scripts/VerifySuite.js",
    "verify.suites": "node Dist/Scripts/VerifySuite.js --list",
    "verify.workspace": "npm run build && npm run verify.suite -- workspace",
    "verify.contracts": "npm run build && npm run verify.suite -- contracts",
    "verify.core": "npm run build && npm run verify.suite -- core",
    "verify.platform": "npm run build && npm run verify.suite -- platform",
    "verify.release": "npm run build && npm run verify.suite -- release",
    "verify.all": "npm run build && npm run verify.suite -- all-local",
    "ci": "npm run quality.security && npm run quality.baml && npm run policy.verify && npm run quality.lint && npm run quality.format && npm run quality.docs && npm run build && npm run desktop.prepare-mcp-runtime && npm --workspace senera-frontend run build && npm run test.frontend.governance && npm run test.integration && npm run quality.coverage && npm run test.e2e.web.run && npm run verify.suite -- workspace core integration e2e platform release",
    "test": "npm run check.types && npm run test.backend && npm run test.frontend",
    "desktop.live": "tsx Apps/Desktop/RunDesktopLive.ts",
    "desktoplive": "npm run desktop.live",
    "desktop.verify": "npm run build && npm --workspace senera-frontend run build",
    "desktopverify": "npm run desktop.verify",
    "desktoppack": "npm run desktop.pack"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "build": {
    "appId": "ai.senera.desktop",
    "productName": "Senera",
    "icon": "Apps/Desktop/Assets/senera-icon",
    "npmRebuild": false,
    "afterPack": "Build/ElectronAfterPack.cjs",
    "directories": {
      "output": "Release"
    },
    "files": [
      "Dist/**/*",
      {
        "from": "Packages/TerminalSidecar",
        "to": "node_modules/@senera/terminal-sidecar",
        "filter": [
          "**/*"
        ]
      },
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.d.ts",
      "!**/docs/**",
      "!**/examples/**",
      "!**/__tests__/**",
      "!**/CHANGELOG*",
      "!**/*.markdown"
    ],
    "extraResources": [
      {
        "from": "Frontend/dist",
        "to": "Frontend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "Apps/Desktop/Assets",
        "to": "Apps/Desktop/Assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "System/Prompts",
        "to": "System/Prompts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "System/Skills",
        "to": "System/Skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "System/Extensions",
        "to": "System/Extensions",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".cache/desktop-mcp-runtime/McpServers",
        "to": "McpServers",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "senera.config.example.json",
        "to": "senera.config.example.json"
      }
    ],
    "extraMetadata": {
      "main": "Dist/Apps/Desktop/Main.js"
    },
    "asarUnpack": [
      "**/*.node",
      "**/*.dll",
      "**/*.so",
      "**/*.dylib",
      "**/ffi-rs/**",
      "**/better-sqlite3/**",
      "**/@node-rs/**",
      "**/@vscode/ripgrep*/bin/**",
      "**/tokenjuice/**"
    ],
    "win": {
      "icon": "Apps/Desktop/Assets/senera-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Senera",
      "artifactName": "SeneraSetup-${version}.${ext}",
      "include": "Build/installer.nsh"
    }
  },
  "dependencies": {
    "@ai-sdk/policy-opa": "^1.0.15",
    "@amaster.ai/pi-task-scheduler": "0.1.7",
    "@boundaryml/baml": "^0.222.0",
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@kang8/chinese-holidays": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@node-rs/jieba": "^2.0.1",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "@senera/terminal-sidecar": "^0.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/mime-types": "^3.0.1",
    "@types/yauzl": "^3.4.0",
    "@vscode/ripgrep": "^1.18.0",
    "@xmldom/xmldom": "^0.9.12",
    "@zavora-ai/computer-use-mcp": "7.1.0",
    "ai": "^7.0.15",
    "ai-sdk-guardrails": "^6.0.1",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "brace-expansion": "5.0.9",
    "busboy": "^1.6.0",
    "chalk": "^4.1.2",
    "chardet": "^2.1.1",
    "chrono-node": "^2.10.1",
    "classificator": "^1.0.1",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "dockerode": "^5.0.1",
    "electron-updater": "^6.8.9",
    "entities": "^8.0.0",
    "eventsource-parser": "^3.0.8",
    "execa": "10.0.1",
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.7.3",
    "file-type": "^22.0.1",
    "fuzzysort": "^4.0.2",
    "gpt-tokenizer": "^3.4.0",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "gray-matter": "^4.0.3",
    "iconv-lite": "^0.7.2",
    "ignore": "^7.0.5",
    "istextorbinary": "^9.5.0",
    "json-parse-even-better-errors": "^5.0.0",
    "json-source-map": "^0.6.1",
    "koffi": "3.1.2",
    "linkedom": "^0.18.13",
    "liquidjs": "^10.27.2",
    "lunar-javascript": "^1.7.7",
    "markdown-it": "^14.1.1",
    "mime-types": "^3.0.2",
    "minimatch": "10.2.5",
    "minisearch": "^7.2.0",
    "officeparser": "^7.2.1",
    "parse5": "^8.0.1",
    "playwright-core": "1.62.1",
    "rrule": "^2.8.1",
    "saxes": "^6.0.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.6.1",
    "stream-json": "^3.5.0",
    "tar-fs": "^3.1.3",
    "tar-stream": "^3.2.0",
    "tokenjuice": "^0.8.1",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.4",
    "typebox": "1.3.7",
    "ws": "^8.20.0",
    "xstate": "^5.32.5",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dockerode": "^4.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.7.1",
    "@types/tar-fs": "^2.0.4",
    "@types/tar-stream": "^3.1.4",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.4",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "immer": "^11.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "@xmldom/xmldom": "^0.9.12",
    "browserslist": "^4.28.9",
    "brace-expansion": "5.0.9",
    "decode-uri-component": "^0.5.0",
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.1",
    "pdfjs-dist": "6.2.108",
    "qs": "^6.16.0",
    "query-string": "^9.5.1",
    "react-inspector": "9.0.0",
    "tar": "7.5.22"
  },
  "optionalDependencies": {
