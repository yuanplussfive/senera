{
  "form": {
    "version": 1,
    "sections": [
      {
        "id": "polling",
        "label": { "zh-CN": "可靠调度", "en-US": "Reliable scheduling" },
        "description": {
          "zh-CN": "所有进程都会扫描 SQLite 中到期的任务，并通过原子认领确保只执行一次。认领过期后可由其他进程恢复。",
          "en-US": "Every process scans due SQLite tasks. Atomic claims prevent duplicate execution and expired claims are recoverable."
        },
        "fields": [
          {
            "path": ["polling", "intervalMs"],
            "label": { "zh-CN": "扫描间隔（毫秒）", "en-US": "Polling interval (ms)" },
            "type": "number",
            "min": 250,
            "max": 60000,
            "step": 250,
            "required": false,
            "essential": true
          },
          {
            "path": ["polling", "claimDurationMs"],
            "label": { "zh-CN": "执行认领时长（毫秒）", "en-US": "Execution claim duration (ms)" },
            "type": "number",
            "min": 5000,
            "max": 3600000,
            "step": 1000,
            "required": false,
            "essential": true
          },
          {
            "path": ["polling", "claimBatchSize"],
            "label": { "zh-CN": "每次认领上限", "en-US": "Claim batch size" },
            "type": "number",
            "min": 1,
            "max": 128,
            "step": 1,
            "required": false,
            "essential": false
          }
        ]
      }
    ]
  }
}
