{
  "name": "ResourcePath",
  "loading": "Bootstrap",
  "description": "Resolve a canonical Senera resource URI to its existing workspace-relative local path and verified media metadata. This does not copy or modify the resource.",
  "presentation": { "icon": "route", "preview": { "body": { "pointer": "/source/path", "from": "result" } } },
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "resourceUri": {
        "type": "string",
        "pattern": "^senera:\\/\\/resource\\/[A-Za-z0-9][A-Za-z0-9._~-]{0,255}$",
        "description": "Canonical Senera resource identity to resolve on this workspace."
      }
    },
    "required": ["resourceUri"],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "source": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "const": "local_path" },
          "path": { "type": "string", "minLength": 1 }
        },
        "required": ["kind", "path"],
        "additionalProperties": false
      },
      "name": { "type": "string" },
      "mime": { "type": "string" },
      "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "sha256": { "type": "string", "minLength": 1 }
    },
    "required": ["source", "name", "mime", "size", "sha256"],
    "additionalProperties": false
  },
  "permissions": ["resources:read"],
  "execution": { "Targets": ["Local"], "Network": "Deny", "Workspace": "ReadOnly" },
  "runtime": {
    "Lifecycle": "Immediate",
    "ProtocolVersion": 2,
    "ResultAssessment": "ProcessExit",
    "Scheduling": "Parallel"
  },
  "resources": [],
  "sources": [],
  "search": {
    "Summary": "把 senera://resource URI 解析为本机可直接读取的工作区相对路径和文件信息。",
    "Tags": ["resource", "path", "upload", "media"],
    "Capabilities": [
      {
        "Id": "resource.resolve-local-path",
        "Title": "Resolve local resource path",
        "Description": "查找已保存的 Senera 上传或 Artifact 资源，并返回经过校验的工作区相对路径。",
        "Facets": {
          "Actions": ["resolve", "locate", "read"],
          "Targets": ["uploaded-resource", "artifact-resource"],
          "Inputs": ["resource-uri"],
          "Outputs": ["workspace-relative-path", "mime", "size", "sha256"],
          "Effects": ["none"]
        },
        "Aliases": ["解析资源路径", "读取资源路径", "获取本地资源路径", "resolve resource path"],
        "Risk": { "SideEffect": "read-only", "Permission": "resources-read" }
      }
    ],
    "UseCases": ["已经获得 Senera 资源 URI，并需要把对应文件交给本机工具读取。"],
    "Avoid": ["不要从路径猜测或构造 Senera URI；需要分析图片或文档时直接使用对应资源工具。"]
  },
  "evidenceCapabilities": []
}
