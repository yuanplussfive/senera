{
  "$schema": "https://schemas.senera.ai/extension/v1.json",
  "schemaVersion": 1,
  "id": "web-tools",
  "version": "1.0.0",
  "displayName": { "zh-CN": "网页工具", "en-US": "Web Tools" },
  "description": {
    "zh-CN": "通过受控的搜索服务和网页读取能力获取外部信息，并保留可追溯引用。",
    "en-US": "Retrieves external information through controlled search and page fetching with traceable citations."
  },
  "priority": 90,
  "configuration": { "schema": "config.schema.json", "ui": "ui.schema.json" },
  "contributions": [
    {
      "kind": "hostTool",
      "contract": "tools/WebSearch.tool.json",
      "capability": "system.tool.web-tools.WebSearch",
      "recommendedForSkills": ["web-research"]
    },
    {
      "kind": "hostTool",
      "contract": "tools/WebFetch.tool.json",
      "capability": "system.tool.web-tools.WebFetch",
      "recommendedForSkills": ["web-research"]
    }
  ]
}
