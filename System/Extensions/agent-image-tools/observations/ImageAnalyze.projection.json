{
  "$schema": "https://schemas.senera.ai/tool-observation-projection/v2.json",
  "schemaVersion": 2,
  "maxTokens": 64000,
  "maxOmissions": 64,
  "artifactFallback": { "strategy": "reference", "requiredWhenTruncated": true },
  "sources": [
    {
      "source": "headline",
      "mode": "text",
      "priority": "essential",
      "requiredForCompletion": true,
      "maxTokens": 128,
      "limits": { "maxDepth": 1, "maxArrayItems": 4, "maxObjectProperties": 8, "maxNodes": 16 }
    },
    {
      "source": "summary",
      "mode": "text",
      "priority": "high",
      "requiredForCompletion": true,
      "maxTokens": 512,
      "limits": { "maxDepth": 1, "maxArrayItems": 4, "maxObjectProperties": 8, "maxNodes": 16 }
    },
    {
      "source": "retrieval",
      "mode": "json",
      "priority": "high",
      "requiredForCompletion": true,
      "maxTokens": 256,
      "limits": { "maxDepth": 12, "maxArrayItems": 256, "maxObjectProperties": 256, "maxNodes": 2048 }
    },
    {
      "source": "result",
      "mode": "auto",
      "priority": "normal",
      "requiredForCompletion": true,
      "maxTokens": 64000,
      "limits": { "maxDepth": 12, "maxArrayItems": 256, "maxObjectProperties": 256, "maxNodes": 2048 }
    },
    {
      "source": "evidence",
      "mode": "orderedArray",
      "priority": "normal",
      "requiredForCompletion": false,
      "maxTokens": 512,
      "limits": { "maxDepth": 12, "maxArrayItems": 256, "maxObjectProperties": 256, "maxNodes": 2048 }
    },
    {
      "source": "delta",
      "mode": "orderedArray",
      "priority": "normal",
      "requiredForCompletion": false,
      "maxTokens": 384,
      "limits": { "maxDepth": 12, "maxArrayItems": 256, "maxObjectProperties": 256, "maxNodes": 2048 }
    },
    {
      "source": "limitations",
      "mode": "orderedArray",
      "priority": "low",
      "requiredForCompletion": false,
      "maxTokens": 192,
      "limits": { "maxDepth": 12, "maxArrayItems": 256, "maxObjectProperties": 256, "maxNodes": 2048 }
    }
  ]
}
