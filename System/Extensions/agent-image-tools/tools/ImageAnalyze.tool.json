{
  "name": "ImageAnalyze",
  "description": "Analyze an uploaded image or screenshot for visible evidence, OCR, or a specific question.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "resourceUri": {
        "type": "string",
        "pattern": "^senera:\\/\\/resource\\/[A-Za-z0-9][A-Za-z0-9._~-]{0,255}$",
        "description": "Exact Senera resource URI supplied by the runtime."
      },
      "task": { "default": "describe", "type": "string", "enum": ["describe", "ocr", "question"] },
      "question": { "type": "string", "minLength": 1 }
    },
    "required": ["resourceUri"],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "resourceUri": { "type": "string", "pattern": "^senera:\\/\\/resource\\/[A-Za-z0-9][A-Za-z0-9._~-]{0,255}$" },
      "name": { "type": "string" },
      "mime": { "type": "string" },
      "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "task": { "type": "string", "enum": ["describe", "ocr", "question"] },
      "question": { "type": "string" },
      "answer": { "type": "string" },
      "model": { "type": "string" }
    },
    "required": ["resourceUri", "name", "mime", "size", "task", "answer", "model"],
    "additionalProperties": false
  },
  "observationProjection": "observations/ImageAnalyze.projection.json",
  "permissions": ["uploads:read", "model:vision"],
  "execution": { "Targets": ["Local"], "Network": "Allow", "Workspace": "ReadOnly" },
  "runtime": {
    "Lifecycle": "Immediate",
    "ProtocolVersion": 2,
    "ResultAssessment": "ProcessExit",
    "Scheduling": "Parallel"
  },
  "resources": [],
  "sources": [],
  "evidenceCapabilities": []
}
