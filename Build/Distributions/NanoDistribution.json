{
  "$schema": "./NanoDistribution.schema.json",
  "schemaVersion": 3,
  "id": "nano",
  "source": {
    "branch": "main",
    "outputBranch": "nano",
    "repositoryUrl": "https://github.com/yuanplussfive/senera"
  },
  "files": {
    "gitPathspecs": [
      ".editorconfig",
      ".gitattributes",
      ".npmrc",
      "LICENSE",
      "package.json",
      "package-lock.json",
      "senera.config.example.json",
      "Apps/RuntimeConfigBootstrap.ts",
      "Apps/ServerRuntime.ts",
      "Apps/ServerWatch.ts",
      "Source",
      "Frontend",
      "Packages",
      "Plugins",
      "System",
      "baml_src",
      ":(exclude,glob)Source/AgentSystem/Sandbox/Gvisor/AgentGvisorDockerRuntime.ts",
      ":(exclude,glob)Source/AgentSystem/Sandbox/Gvisor/AgentGvisorWorkerServer.ts",
      ":(exclude,glob)Frontend/**/*.stories.tsx"
    ],
    "projections": [
      {
        "source": "Build/Distributions/NanoGitignore.template",
        "target": ".gitignore"
      },
      {
        "source": "Build/Distributions/NanoDevServer.ts.template",
        "target": "Apps/DevServer.ts"
      }
    ]
  },
  "runtime": {
    "sandbox": {
      "provider": "microsandbox",
      "bundle": {
        "distributionContract": "Source/AgentSystem/Sandbox/Distribution/contract.json",
        "sourceRoot": "Release/SandboxImage",
        "targetRoot": "Release/SandboxImage",
        "target": "x64"
      }
    }
  },
  "rootPackage": {
    "copyFields": ["name", "version", "keywords", "author", "license", "type", "workspaces", "overrides"],
    "setFields": {
      "private": true,
      "description": "Senera Nano source development distribution.",
      "engines": {
        "node": ">=22 <23"
      }
    },
    "scripts": ["dev", "dev.server", "dev.server.dry-run", "dev.frontend", "check.types", "check.frontend-types"],
    "dependencies": {
      "mode": "exclude",
      "names": ["dockerode", "fast-glob", "tar-fs", "tslib"]
    },
    "devDependencies": {
      "mode": "include",
      "names": [
        "@types/markdown-it",
        "@types/node",
        "@types/react",
        "@types/react-dom",
        "@types/ws",
        "@vitejs/plugin-react",
        "autoprefixer",
        "concurrently",
        "postcss",
        "tailwindcss",
        "tsx",
        "typescript",
        "vite"
      ]
    },
    "optionalDependencies": {
      "mode": "all"
    }
  },
  "workspacePackages": {
    "Frontend/package.json": {
      "scripts": ["dev", "check.types"]
    }
  },
  "typescript": {
    "include": [
      "Apps/DevServer.ts",
      "Apps/ServerRuntime.ts",
      "Apps/ServerWatch.ts",
      "Plugins/**/*.ts",
      "Source/**/*.ts",
      "System/**/*.ts"
    ]
  },
  "generatedFiles": {
    "readmeTemplate": "Build/Distributions/NanoREADME.md",
    "metadataFile": "SENERA_NANO.json"
  }
}
