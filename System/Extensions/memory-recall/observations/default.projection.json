{
  "$schema": "https://schemas.senera.ai/tool-observation-projection/v1.json",
  "schemaVersion": 1,
  "maxTokens": 2048,
  "maxOmissions": 16,
  "artifactFallback": {
    "strategy": "reference",
    "requiredWhenTruncated": true
  },
  "sources": [
    {
      "source": "summary",
      "mode": "text",
      "priority": "essential",
      "maxTokens": 512,
      "limits": {
        "maxDepth": 1,
        "maxArrayItems": 0,
        "maxObjectProperties": 0,
        "maxStringCharacters": 4096,
        "maxTotalCharacters": 4096,
        "maxNodes": 2
      }
    },
    {
      "source": "summaryFacts",
      "mode": "orderedArray",
      "priority": "high",
      "maxTokens": 512,
      "limits": {
        "maxDepth": 4,
        "maxArrayItems": 24,
        "maxObjectProperties": 12,
        "maxStringCharacters": 1024,
        "maxTotalCharacters": 6144,
        "maxNodes": 192
      }
    },
    {
      "source": "retrieval",
      "mode": "json",
      "priority": "high",
      "maxTokens": 256,
      "limits": {
        "maxDepth": 4,
        "maxArrayItems": 24,
        "maxObjectProperties": 12,
        "maxStringCharacters": 1024,
        "maxTotalCharacters": 3072,
        "maxNodes": 96
      }
    },
    {
      "source": "result",
      "mode": "auto",
      "priority": "normal",
      "maxTokens": 1024,
      "limits": {
        "maxDepth": 8,
        "maxArrayItems": 32,
        "maxObjectProperties": 48,
        "maxStringCharacters": 2048,
        "maxTotalCharacters": 12288,
        "maxNodes": 384
      }
    }
  ]
}
