        "maxArrayItems": 0,
        "maxObjectProperties": 0,
        "maxNodes": 2
      },
      "requiredForCompletion": true
    },
    {
      "source": "summary",
      "mode": "text",
      "priority": "essential",
      "maxTokens": 384,
      "limits": {
        "maxDepth": 1,
        "maxArrayItems": 0,
