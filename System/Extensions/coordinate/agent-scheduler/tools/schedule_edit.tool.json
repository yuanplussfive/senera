  "description": "Update, pause, resume, delete, or deliver an owned schedule immediately.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "schedule_id": {
        "type": "string",
        "minLength": 1,
        "description": "Schedule ID returned by schedule_create or schedule_list."
      },
      "operation": {
        "type": "string",
        "enum": ["update", "pause", "resume", "delete", "run_now"]
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Short label."
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "description": "Instructions to deliver."
      },
      "rrule": {
        "type": "string",
        "minLength": 1,
        "description": "RFC 5545 RRULE, for example RRULE:FREQ=DAILY;BYHOUR=9;BYMINUTE=0;BYSECOND=0."
      },
      "at": {
        "type": "string",
        "minLength": 1,
        "description": "Replacement one-time timestamp or relative duration. Offsetless values use the schedule timezone."
      },
      "time_zone": {
        "type": "string",
        "minLength": 1,
        "description": "Optional IANA timezone. Omission uses Senera’s shared default timezone; specify only when the user requests another timezone."
      }
    },
    "required": ["schedule_id", "operation"],
    "additionalProperties": false,
    "not": {
      "required": ["rrule", "at"]
    }
  },
