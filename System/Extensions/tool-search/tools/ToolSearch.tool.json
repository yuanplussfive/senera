{
  "name": "ToolSearch",
  "loading": "Bootstrap",
  "observationProjection": "observations/default.projection.json",
  "description": "搜索当前授权范围内可发现的动态工具，按匹配度返回完整候选目录；不会自动加载或调用候选工具。",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "需要完成的任务、问题、错误文本或希望寻找的能力。"
      },
      "preferredSources": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "优先检索的工具来源；仅影响排序，不排除其他来源。可用值由当前扩展注册表动态注入。"
      },
      "includeLoaded": {
        "type": "boolean",
        "description": "是否包含当前已经加载进提示词的工具；默认 false。"
      }
    },
    "required": ["query"],
    "additionalProperties": false,
    "definitions": {}
  },
  "permissions": [],
  "execution": {
    "Targets": ["Local"],
    "Network": "Deny",
    "Workspace": "ReadOnly"
  },
  "runtime": {
    "Lifecycle": "Immediate",
    "ProtocolVersion": 2,
    "ResultAssessment": "ProcessExit",
    "Scheduling": "Parallel",
    "Capabilities": {
      "Cancellation": true
    }
  },
  "resources": [],
  "sources": [
    {
      "Id": "tools",
      "Title": "Tools",
      "Description": "Capabilities contributed by the currently loaded extension catalog."
    }
  ],
  "search": {
    "Summary": "搜索当前授权范围内可发现的动态工具，按匹配度返回完整候选目录；不会自动加载或调用候选工具。",
    "Capabilities": [
      {
        "Id": "tool.catalog-search",
        "Title": "Tool catalog search",
        "Description": "Search registered tools without changing the active tool set.",
        "Facets": {
          "Actions": ["search", "discover", "route"],
          "Targets": ["tool-catalog", "capability-catalog", "runtime-tools"],
          "Inputs": ["task", "query", "capability-need"],
          "Outputs": ["tool-candidate", "matched-capability", "routing-hint"],
          "Evidence": ["tool-candidate"],
          "Effects": ["read-only", "context-load"]
        },
        "Aliases": ["工具发现", "查找能力", "load matching tools", "discover available tool"],
        "Risk": {
          "SideEffect": "context-load",
          "Permission": "none",
          "Notes": ["Only searches registered tool metadata."]
        }
      }
    ],
    "UseCases": [
      "不确定该调用哪个工具时先搜索工具目录。",
      "先找到候选，再用 ToolDescribe 获取准确契约，并按当前模型协议调用。"
    ],
    "Examples": ["网页搜索工具发现", "文件编辑工具发现", "workspace code search tool", "动态工具能力检索"],
    "Tags": ["能力发现", "工具检索", "动态加载", "工具选择"]
  },
  "evidenceCapabilities": []
}
