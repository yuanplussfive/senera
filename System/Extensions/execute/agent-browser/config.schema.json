{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "runtime": {
      "default": {
        "context": "persistent",
        "headed": false,
        "requestTimeoutMs": 180000,
        "maxOperationTimeoutMs": 900000,
        "idleTimeoutMs": 900000,
        "outputMaxChars": 96000,
        "maxUrlLength": 8192,
        "maxSelectorLength": 4096,
        "maxTextChars": 120000,
        "maxWaitMs": 900000
