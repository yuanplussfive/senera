        "maxNodes": 2
      },
      "requiredForCompletion": true
    },
    {
      "source": "retrieval",
      "mode": "json",
      "priority": "high",
      "maxTokens": 192,
      "limits": {
        "maxDepth": 4,
        "maxArrayItems": 24,
        "maxObjectProperties": 12,
        "maxNodes": 96
      },
      "requiredForCompletion": true
    },
    {
      "source": "result",
      "mode": "auto",
      "priority": "normal",
      "maxTokens": 6144,
      "limits": {
        "maxDepth": 8,
        "maxArrayItems": 96,
        "maxObjectProperties": 48,
        "maxNodes": 512
      },
      "requiredForCompletion": true
    }
  ]
